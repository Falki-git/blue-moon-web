    /* Below ~470px the password no longer fits at 1.05rem, so let it scale with
       the viewport rather than wrapping onto a second line. */
    .gg-cred__value--pw { font-size: clamp(0.76rem, 3.6vw, 1.05rem); letter-spacing: 0; }

    /* House notes: emoji beside the heading, body text tucked underneath it. */
