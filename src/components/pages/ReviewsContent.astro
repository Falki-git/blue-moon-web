---
import PageLayout from '../../layouts/PageLayout.astro';
import { HREFLANG_MAP, type SupportedLang, type Translations } from '../../i18n/utils';
import heroBg from '../../assets/gallery/reviews-1.jpg';

interface Props {
  lang: string;
  T: Translations;
}

const { lang, T } = Astro.props;
const prefix = lang === 'en' ? '' : `/${lang}`;

const R = T.reviews;

// Guest name, flag, score and publication date are language-neutral, so they stay
// here; the country name, display month and the review copy come from R.items,
// which every locale file supplies in this same order.
const reviewMeta = [
  { name: 'Bartosz',          flag: '🇵🇱', country: R.countryPoland,   rating: 10, published: '2025-09', month: R.monthSeptember, year: 2025 },
  { name: 'Tomasz',           flag: '🇵🇱', country: R.countryPoland,   rating: 10, published: '2025-09', month: R.monthSeptember, year: 2025 },
  { name: 'Alex',             flag: '🇩🇪', country: R.countryGermany,  rating: 10, published: '2025-06', month: R.monthJune,      year: 2025 },
  { name: 'Patryk',           flag: '🇵🇱', country: R.countryPoland,   rating: 10, published: '2024-09', month: R.monthSeptember, year: 2024 },
  { name: 'Žiga',             flag: '🇸🇮', country: R.countrySlovenia, rating: 10, published: '2024-09', month: R.monthSeptember, year: 2024 },
  { name: 'Iveta',            flag: '🇸🇰', country: R.countrySlovakia, rating: 10, published: '2024-08', month: R.monthAugust,    year: 2024 },
  { name: 'Paolo',            flag: '🇮🇹', country: R.countryItaly,    rating: 10, published: '2024-08', month: R.monthAugust,    year: 2024 },
  { name: 'Korban / Łukasz',  flag: '🇵🇱', country: R.countryPoland,   rating: 10, published: '2024-08', month: R.monthAugust,    year: 2024 },
  { name: 'Pavla',            flag: '🇨🇿', country: R.countryCzechia,  rating: 10, published: '2024-08', month: R.monthAugust,    year: 2024 },
];

const reviews = reviewMeta.map((meta, i) => ({
  ...meta,
  ...R.items[i],
  id: i + 1,
  date: `${meta.month} ${meta.year}`,
  booking: R.bookingComSource,
}));

const avgRating = (reviews.reduce((s, r) => s + r.rating, 0) / reviews.length).toFixed(1);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  'name': 'Blue Moon Apartment',
  'url': `https://bluemoonmandre.eu${prefix}/`,
  'aggregateRating': {
    '@type': 'AggregateRating',
    'ratingValue': '10',
    'bestRating': '10',
    'worstRating': '1',
    'reviewCount': '12',
  },
  'review': reviews.map(r => ({
    '@type': 'Review',
    'inLanguage': HREFLANG_MAP[lang as SupportedLang] ?? 'en',
    'name': r.title,
    'reviewBody': r.text,
    'datePublished': r.published,
    'author': { '@type': 'Person', 'name': r.name },
    'reviewRating': {
      '@type': 'Rating',
      'ratingValue': String(r.rating),
      'bestRating': '10',
      'worstRating': '1',
    },
  })),
};
---

<PageLayout
  title={T.reviews.metaTitle}
  description={T.reviews.metaDescription}
  pageTitle={T.reviews.pageTitle}
  pageSubtitle={T.reviews.pageSubtitle}
  label={T.reviews.label}
  bgClass="ph-sea"
  bgImage={heroBg}
  lang={lang}
>

  <!-- ═══ SUMMARY BAR ═══ -->
  <section class="section-sm" style="background:var(--soft-sky);">
    <div class="container">
      <div class="rating-summary">
        <div class="rating-summary__score">
          <span class="rating-summary__num">{avgRating}</span>
          <div>
            <div class="stars" style="font-size:1.4rem;">★★★★★</div>
            <span class="rating-summary__count">{T.reviews.ratingCount}</span>
          </div>
        </div>
        <div class="rating-bars">
          <div class="rating-bar">
            <span>{T.reviews.cleanlinessLabel}</span>
            <div class="bar"><div class="bar__fill" style="width:100%"></div></div>
            <span class="bar__label">10.0</span>
          </div>
          <div class="rating-bar">
            <span>{T.reviews.locationLabel}</span>
            <div class="bar"><div class="bar__fill" style="width:100%"></div></div>
            <span class="bar__label">10.0</span>
          </div>
          <div class="rating-bar">
            <span>{T.reviews.hostLabel}</span>
            <div class="bar"><div class="bar__fill" style="width:100%"></div></div>
            <span class="bar__label">10.0</span>
          </div>
          <div class="rating-bar">
            <span>{T.reviews.valueLabel}</span>
            <div class="bar"><div class="bar__fill" style="width:100%"></div></div>
            <span class="bar__label">10.0</span>
          </div>
        </div>
        <div class="rating-summary__cta">
          <p>{T.reviews.joinGuests}</p>
          <a href={`${prefix}/booking`} class="btn btn-primary btn-sm">{T.reviews.bookStay}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ REVIEWS GRID ═══ -->
  <section class="section">
    <div class="container">
      <div class="reviews-masonry">
        {reviews.map(review => (
          <article class="review-full card">
            <header class="review-full__header">
              <div class="review-full__stars">{review.rating} / 10</div>
              <div class="review-full__meta">
                <span class="review-full__badge">{review.booking}</span>
              </div>
            </header>
            {review.title && <h3 class="review-full__title">"{review.title}"</h3>}
            {review.text && <blockquote class="review-full__text">{review.text}</blockquote>}
            <div class="review-full__highlights">
              {review.highlights.map(h => (
                <span class="highlight-chip">{h}</span>
              ))}
            </div>
            <footer class="review-full__footer">
              <div class="review-full__author">
                <strong>{review.name}</strong>
                <span>{review.flag} {review.country} · {T.reviews.verifiedGuest}</span>
              </div>
              <span class="review-full__date">{review.date}</span>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ LEAVE A REVIEW ═══ -->
  <section class="section-sm" style="background:var(--soft-sky); text-align:center;">
    <div class="container">
      <h2 style="margin-bottom:0.75rem;">{T.reviews.stayedWithUs}</h2>
      <p style="color:var(--text-muted); margin-bottom:1.75rem; max-width:480px; margin-left:auto; margin-right:auto;">{T.reviews.leaveReviewBody}</p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a href="https://www.booking.com/hotel/hr/blue-moon-apartment-mandre.en-gb.html" target="_blank" rel="noopener" class="btn btn-primary">{T.reviews.leaveReviewBtn}</a>
        <a href={`${prefix}/contact`} class="btn btn-secondary">{T.reviews.contactBtn}</a>
      </div>
    </div>
  </section>

</PageLayout>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  /* Rating summary */
  .rating-summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 3rem;
    align-items: center;
    padding: 2rem 2.5rem;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .rating-summary__score {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .rating-summary__num {
    font-family: 'Playfair Display', serif;
    font-size: 4rem;
    font-weight: 700;
    color: var(--ocean-blue);
    line-height: 1;
  }
  .rating-summary__count {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
    display: block;
    margin-top: 0.2rem;
  }

  .rating-bars {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 280px;
  }
  .rating-bar {
    display: grid;
    grid-template-columns: 80px 1fr 30px;
    align-items: center;
    gap: 0.75rem;
  }
  .rating-bar > span:first-child {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-dark);
    text-align: right;
  }
  .bar {
    height: 7px;
    background: rgba(74,159,212,0.18);
    border-radius: 50px;
    overflow: hidden;
  }
  .bar__fill {
    height: 100%;
    background: var(--sky-blue);
    border-radius: 50px;
  }
  .bar__label {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ocean-blue);
  }

  .rating-summary__cta { text-align: center; }
  .rating-summary__cta p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .reviews-masonry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .review-full {
    padding: 1.75rem;
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .review-full__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .review-full__stars {
    color: var(--sunset-gold);
    font-size: 1rem;
    letter-spacing: 0.05em;
  }
  .review-full__badge {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--soft-sky);
    color: var(--sky-blue);
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
  }

  .review-full__title {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ocean-blue);
    font-style: italic;
  }

  .review-full__text {
    font-size: 0.9rem;
    color: var(--text-dark);
    line-height: 1.75;
    font-style: normal;
  }

  .review-full__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .highlight-chip {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--sky-blue);
    background: rgba(74,159,212,0.1);
    padding: 0.25rem 0.65rem;
    border-radius: 50px;
    letter-spacing: 0.02em;
  }

  .review-full__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-top: 1px solid rgba(74,159,212,0.12);
    padding-top: 0.85rem;
    gap: 0.5rem;
  }
  .review-full__author { display: flex; flex-direction: column; gap: 0.15rem; }
  .review-full__author strong { font-size: 0.9rem; color: var(--ocean-blue); }
  .review-full__author span   { font-size: 0.78rem; color: var(--text-muted); }
  .review-full__date {
    font-size: 0.75rem;
    color: var(--text-light);
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .rating-summary { grid-template-columns: 1fr; gap: 1.5rem; text-align: center; }
    .rating-summary__score { justify-content: center; }
    .rating-bar > span:first-child { text-align: left; }
    .reviews-masonry { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .reviews-masonry { grid-template-columns: 1fr; }
    .rating-bars { min-width: unset; }
  }
</style>
