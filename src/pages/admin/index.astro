    function calcRangesFor(containerId: string) {
      const container = document.getElementById(containerId);
      if (!container) return;
      const prefix = (container as HTMLElement).dataset.prefix ?? 'gf';
      const suffix = (container as HTMLElement).dataset.suffix ?? '';
      const id = (n: string) => document.getElementById(`${prefix}-${n}${suffix}`);

      const rows = container.querySelectorAll('.range-row');
      let totalNights = 0;
      let finalPrice  = 0;
      let firstStart  = '';
      let lastEnd     = '';

      rows.forEach(row => {
        const start = (row.querySelector('.range-start') as HTMLInputElement)?.value ?? '';
        const end   = (row.querySelector('.range-end')   as HTMLInputElement)?.value ?? '';
        const full    = parseFloat((row.querySelector('.range-full') as HTMLInputElement)?.value ?? '') || 0;
        const discEl  = row.querySelector('.range-disc') as HTMLInputElement | null;
        const disc    = parseFloat(discEl?.value ?? '') || 0;
        const discErr = full > 0 && disc > full;
        discEl?.classList.toggle('range-disc--error', discErr);
        if (discEl) discEl.title = discErr ? 'Discounted price cannot exceed full price' : '';

        let nights = 0;
        if (start && end && end > start) {
          nights = Math.round((new Date(end).getTime() - new Date(start).getTime()) / 86400000);
        }
        const discPct  = discErr ? '—' : (full > 0 ? ((full - disc) / full * 100).toFixed(1) + '%' : '—');
        const rangeTot = !discErr && nights > 0 ? disc * nights : 0;

        (row.querySelector('.range-nights')   as HTMLElement).textContent = nights > 0 ? String(nights) : '—';
        (row.querySelector('.range-disc-pct') as HTMLElement).textContent = discPct;
        (row.querySelector('.range-total')    as HTMLElement).textContent = rangeTot > 0 ? '€' + rangeTot.toFixed(2) : '—';

        if (nights > 0) {
          if (!firstStart || start < firstStart) firstStart = start;
          if (!lastEnd   || end   > lastEnd)     lastEnd   = end;
          totalNights += nights;
          finalPrice  += rangeTot;
        }
      });

      // Footer totals (keyed by ID for reliability across add/edit forms)
      const tnEl = id('total-nights');
      const fpEl = id('final-price');
      if (tnEl) tnEl.textContent = totalNights > 0 ? String(totalNights) : '—';
      if (fpEl) fpEl.textContent = totalNights > 0 ? '€' + finalPrice.toFixed(2) : '—';

      // Financial fields
      const commission  = parseFloat((id('commission') as HTMLInputElement)?.value ?? '') || 0;
      const vatChecked  = (id('vat') as HTMLInputElement)?.checked ?? false;
      const totalEl     = id('total') as HTMLInputElement | null;
      const totalGuests = parseInt(totalEl?.value ?? '1') || 1;
      const feeEl       = id('cleaning-fee') as HTMLInputElement | null;
      if (feeEl && !feeEl.value) feeEl.value = (140 + 7 * totalGuests).toFixed(2);
      const cleaningFee = parseFloat(feeEl?.value ?? '') || 0;

      const commPct  = finalPrice > 0 ? (commission / finalPrice * 100).toFixed(1) + '%' : '—';
      const payout   = finalPrice - commission;
      const vatAmt   = vatChecked ? commission * 0.25 : 0;
      const netGain  = finalPrice - commission - vatAmt - cleaningFee;

      const setText = (n: string, t: string) => { const el = id(n); if (el) el.textContent = t; };
      setText('commission-pct', commPct);
      setText('payout',     finalPrice > 0 ? '€' + payout.toFixed(2)  : '—');
      setText('vat-amount', '€' + vatAmt.toFixed(2));
      setText('net-gain',   finalPrice > 0 ? '€' + netGain.toFixed(2) : '—');
    }
    (window as any).__calcRangesFor = calcRangesFor;

    /** Range rows look the same everywhere; what they add up to depends on the form. */
