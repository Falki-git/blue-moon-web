      return {
        full_name:      t('full_name'),
        email:          t('email'),
        phone:          orNull('phone'),
        language:       orNull('language'),
        country:        orNull('country'),
        address:        orNull('address'),
        source:         orNull('source'),
        adults:         Number(t('adults')),
        children:       Number(t('children')),
        children_ages:  orNull('children_ages'),
        // Check-in, check-out, nights and both totals are derived from these server-side,
        // so there is nothing else to send and nothing that can disagree with them.
        ranges:         collectRanges(`${prefix}-ranges`),
        message:        orNull('message'),
      };
    }

