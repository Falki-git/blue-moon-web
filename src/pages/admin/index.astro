    async function saveMinAdvanceDays() {
      const input = document.getElementById('setting-min-advance-days') as HTMLInputElement;
      const btn   = document.getElementById('setting-min-advance-btn') as HTMLButtonElement;
      const days  = Number(input.value);
      if (!Number.isInteger(days) || days < 0 || days > 30) { alert('Enter a valid number (0–30)'); return; }
      try {
        await api('/api/admin/settings', {
          method: 'POST',
          body: JSON.stringify({ minAdvanceDays: days }),
        });
        btn.classList.add('adm-pricing-row__btn--saved');
        btn.textContent = 'Saved ✓';
        setTimeout(() => {
          btn.classList.remove('adm-pricing-row__btn--saved');
          btn.textContent = 'Save';
        }, 1800);
        await refresh();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Save failed');
      }
    }
    (window as any).__saveMinAdvanceDays = saveMinAdvanceDays;

    async function saveKeyLockerCode() {
      const input = document.getElementById('setting-key-locker-code') as HTMLInputElement;
      const btn   = document.getElementById('setting-key-locker-btn') as HTMLButtonElement;
      const code  = input.value.trim();
      if (!/^\d{4}$/.test(code)) { alert('Enter exactly 4 digits'); return; }
      try {
        await api('/api/admin/settings', {
          method: 'POST',
          body: JSON.stringify({ keyLockerCode: code }),
        });
        btn.classList.add('adm-pricing-row__btn--saved');
        btn.textContent = 'Saved ✓';
        setTimeout(() => {
          btn.classList.remove('adm-pricing-row__btn--saved');
          btn.textContent = 'Save';
        }, 1800);
        await refresh();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Save failed');
      }
    }
    (window as any).__saveKeyLockerCode = saveKeyLockerCode;

    async function savePricing(month: number) {
      const rateInput     = document.getElementById(`pr-rate-${month}`) as HTMLInputElement;
      const discountInput = document.getElementById(`pr-discount-${month}`) as HTMLInputElement;
      const btn           = document.getElementById(`pr-btn-${month}`) as HTMLButtonElement;
      const rate     = Number(rateInput.value);
      const discount = discountInput.value.trim() !== '' ? Number(discountInput.value) : rate;
      if (!Number.isFinite(rate) || rate < 0) { alert('Enter a valid rate'); return; }
      if (!Number.isFinite(discount) || discount < 0) { alert('Enter a valid discount rate'); return; }
      if (discount > rate) { alert('Discount rate cannot exceed the full rate'); return; }
      try {
        await api('/api/admin/pricing', {
          method: 'POST',
          body: JSON.stringify({ month, rate_eur: rate, discount_rate_eur: discount }),
        });
        btn.classList.add('adm-pricing-row__btn--saved');
        btn.textContent = 'Saved ✓';
        setTimeout(() => {
          btn.classList.remove('adm-pricing-row__btn--saved');
          btn.textContent = 'Save';
        }, 1800);
        await refresh();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Save failed');
      }
    }
    (window as any).__savePricing = savePricing;

    function updateDiscountHint(month: number) {
      const rateEl    = document.getElementById(`pr-rate-${month}`) as HTMLInputElement | null;
      const discountEl = document.getElementById(`pr-discount-${month}`) as HTMLInputElement | null;
      const badge      = document.getElementById(`pr-badge-${month}`) as HTMLElement | null;
      if (!rateEl || !discountEl || !badge) return;
      const rate = Number(rateEl.value);
      const disc = Number(discountEl.value);
      if (rate > 0 && Number.isFinite(disc) && disc >= 0 && disc < rate) {
        const pct = Math.round((1 - disc / rate) * 100);
        badge.textContent = `-${pct}%`;
        badge.style.display = '';
      } else {
        badge.style.display = 'none';
      }
    }
    (window as any).__updateDiscountHint = updateDiscountHint;

    // ── Crew docs ────────────────────────────────────────────────────────────

    function renderDocsList(docs: DocItem[]): string {
      if (docs.length === 0) return '<p class="adm-empty">No documents yet.</p>';
      return `<table class="adm-table"><thead><tr><th>Title</th><th>Shareable URL</th><th>Updated</th><th></th></tr></thead><tbody>${
        docs.map(d => `
          <tr>
            <td><strong>${esc(d.title)}</strong></td>
            <td style="font-size:0.75rem;color:var(--text-muted);font-family:monospace;">/cleaning/docs?doc=${esc(d.slug)}</td>
            <td style="font-size:0.78rem;color:var(--text-muted);white-space:nowrap;">${fmtTs(d.updated_at)}</td>
            <td style="white-space:nowrap;">
              <button class="adm-btn adm-btn--sm" onclick="__editDoc('${d.id}')">Edit</button>
              <button class="adm-btn adm-btn--sm adm-btn--remove" onclick="__removeDoc('${d.id}')">Remove</button>
            </td>
          </tr>
        `).join('')
      }</tbody></table>`;
    }

    async function saveDoc() {
      const titleEl   = document.getElementById('doc-title') as HTMLInputElement;
      const contentEl = document.getElementById('doc-content') as HTMLTextAreaElement;
      const errEl     = document.getElementById('docError') as HTMLElement;
      errEl.hidden = true;
      const title      = titleEl.value.trim();
      const content_md = contentEl.value;
      if (!title) { errEl.textContent = 'Title is required'; errEl.hidden = false; return; }
      try {
        if (editingDocId) {
          await api(`/api/admin/docs/${editingDocId}`, { method: 'PUT', body: JSON.stringify({ title, content_md }) });
          editingDocId = null;
        } else {
          await api('/api/admin/docs', { method: 'POST', body: JSON.stringify({ title, content_md }) });
        }
        titleEl.value   = '';
        contentEl.value = '';
        (document.getElementById('doc-save-btn') as HTMLButtonElement).textContent = 'Add doc';
        (document.getElementById('doc-cancel-btn') as HTMLButtonElement).hidden = true;
        await refresh();
      } catch (e) {
        errEl.textContent = e instanceof Error ? e.message : 'Save failed';
        errEl.hidden = false;
      }
    }
    (window as any).__saveDoc = saveDoc;

    async function editDoc(id: string) {
      try {
        const { doc } = await api<{ doc: { id: string; title: string; content_md: string } }>(`/api/admin/docs/${id}`);
        (document.getElementById('doc-title') as HTMLInputElement).value       = doc.title;
        (document.getElementById('doc-content') as HTMLTextAreaElement).value  = doc.content_md;
        (document.getElementById('doc-save-btn') as HTMLButtonElement).textContent = 'Save changes';
        (document.getElementById('doc-cancel-btn') as HTMLButtonElement).hidden    = false;
        (document.getElementById('docError') as HTMLElement).hidden = true;
        editingDocId = id;
        document.getElementById('doc-title')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Failed to load doc');
      }
    }
    (window as any).__editDoc = editDoc;

    function cancelDocEdit() {
      editingDocId = null;
      (document.getElementById('doc-title') as HTMLInputElement).value        = '';
      (document.getElementById('doc-content') as HTMLTextAreaElement).value   = '';
      (document.getElementById('doc-save-btn') as HTMLButtonElement).textContent = 'Add doc';
      (document.getElementById('doc-cancel-btn') as HTMLButtonElement).hidden    = true;
      (document.getElementById('docError') as HTMLElement).hidden = true;
    }
    (window as any).__cancelDocEdit = cancelDocEdit;

    async function removeDoc(id: string) {
      if (!confirm('Remove this document?')) return;
      try {
        await api(`/api/admin/docs/${id}`, { method: 'DELETE' });
        if (editingDocId === id) cancelDocEdit();
        await refresh();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Remove failed');
      }
    }
    (window as any).__removeDoc = removeDoc;

    async function refresh() {
      const [resData, blockData, priceData, settingsData, cleaningData, docsData] = await Promise.all([
        api<{ reservations: Reservation[] }>('/api/admin/reservations'),
        api<{ blocks: ManualBlock[] }>('/api/admin/blocks'),
        api<{ pricing: PricingRule[] }>('/api/admin/pricing'),
        api<BookingSettings>('/api/admin/settings'),
        api<{ guests: CleaningGuest[] }>('/api/admin/cleaning-guests'),
        api<{ docs: DocItem[] }>('/api/admin/docs'),
      ]);

      currentReservations = resData.reservations;
      renderReservationLists();

      const blocks = blockData.blocks;
      const blocksHtml = blocks.length === 0
        ? '<p class="adm-empty">No manual blocks.</p>'
        : `<table class="adm-table"><thead><tr><th>From</th><th>To</th><th>Note</th><th></th></tr></thead><tbody>${
            blocks.map(b => `
              <tr>
                <td>${fmtDate(b.from_date)}</td>
                <td>${fmtDate(b.to_date)}</td>
                <td>${b.note ? esc(b.note) : '<span style="color:var(--text-light);">—</span>'}</td>
                <td><button class="adm-btn adm-btn--remove" onclick="__removeBlock('${b.id}')">Remove</button></td>
              </tr>
            `).join('')
          }</tbody></table>`;
      document.getElementById('blocksList')!.innerHTML = blocksHtml;

      const pricingByMonth = new Map<number, PricingRule>();
      for (const p of priceData.pricing) pricingByMonth.set(p.month, p);
      const pricingHtml = [6, 7, 8, 9].map(m => {
        const p = pricingByMonth.get(m);
        const rate     = p?.rate_eur ?? 0;
        const discount = p?.discount_rate_eur != null ? p.discount_rate_eur : rate;
        const pct      = rate > 0 && discount < rate ? Math.round((1 - discount / rate) * 100) : 0;
        const updated  = p ? fmtTs(p.updated_at) : '—';
        return `
          <div class="adm-pricing-row">
            <div class="adm-pricing-row__month">${monthName(m)}</div>
            <div class="adm-pricing-row__updated">Last updated: ${updated}</div>
            <div class="adm-pricing-row__inputs">
              <div class="adm-pricing-row__field">
                <span class="adm-pricing-row__field-label">Full</span>
                <span>€</span><input type="number" id="pr-rate-${m}" class="adm-pricing-row__input" value="${rate}" min="0" max="10000" oninput="__updateDiscountHint(${m})" />
              </div>
              <div class="adm-pricing-row__field">
                <span class="adm-pricing-row__field-label">Discounted</span>
                <span>€</span><input type="number" id="pr-discount-${m}" class="adm-pricing-row__input" value="${discount}" min="0" max="10000" oninput="__updateDiscountHint(${m})" />
                <span class="adm-pricing-row__disc-badge" id="pr-badge-${m}"${pct > 0 ? '' : ' style="display:none"'}>-${pct}%</span>
              </div>
            </div>
            <button class="adm-pricing-row__btn" id="pr-btn-${m}" onclick="__savePricing(${m})">Save</button>
          </div>
        `;
      }).join('');
      document.getElementById('pricingList')!.innerHTML = pricingHtml;

      document.getElementById('settingsList')!.innerHTML = `
        <div class="adm-settings-row">
          <div style="flex:1;">
            <div class="adm-settings-row__label">Minimum advance booking days</div>
            <div class="adm-settings-row__hint">Guests must book this many days before their check-in date. 0 = same-day booking allowed.</div>
          </div>
          <input type="number" id="setting-min-advance-days" class="adm-settings-row__input" value="${settingsData.minAdvanceDays}" min="0" max="30" />
          <button class="adm-pricing-row__btn" id="setting-min-advance-btn" onclick="__saveMinAdvanceDays()">Save</button>
        </div>
        <div class="adm-settings-row">
          <div style="flex:1;">
            <div class="adm-settings-row__label">Key-locker combination</div>
            <div class="adm-settings-row__hint">Four digits. Sent to guests in the arrival email — change it here and every mail sent afterwards carries the new code.</div>
          </div>
          <input type="text" id="setting-key-locker-code" class="adm-settings-row__input" value="${esc(settingsData.keyLockerCode)}" inputmode="numeric" maxlength="4" pattern="\\d{4}" />
          <button class="adm-pricing-row__btn" id="setting-key-locker-btn" onclick="__saveKeyLockerCode()">Save</button>
        </div>
      `;

      currentGuests = cleaningData.guests;
      document.getElementById('guestCount')!.textContent = String(currentGuests.length);
      document.getElementById('guestsList')!.innerHTML = renderGuestTable(currentGuests);

      // Which reservations already have a guest row, so the booking tab can offer to add
      // the ones that do not. Redrawn here because the guest list arrives in the same
      // refresh as the reservations and the tables above were rendered without it.
      guestLinkedIds = new Set(
        currentGuests.map(g => g.reservation_id).filter((id): id is string => id !== null),
      );
      renderReservationLists();

      currentDocs = docsData.docs;
      document.getElementById('docsList')!.innerHTML = renderDocsList(currentDocs);
    }

    logoutBtn.addEventListener('click', async () => {
      try { await fetch('/api/admin/logout', { method: 'POST', credentials: 'same-origin' }); }
      finally { window.location.href = '/admin/login'; }
    });

    const blockForm = document.getElementById('blockForm') as HTMLFormElement;
    const blockError = document.getElementById('blockError') as HTMLElement;
    blockForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      blockError.hidden = true;
      const fd = new FormData(blockForm);
      try {
        await api('/api/admin/blocks', {
          method: 'POST',
          body: JSON.stringify({
            from: String(fd.get('from')),
            to:   String(fd.get('to')),
            note: String(fd.get('note') ?? ''),
          }),
        });
        blockForm.reset();
        await refresh();
      } catch (e) {
        blockError.textContent = e instanceof Error ? e.message : 'Failed to add block';
        blockError.hidden = false;
      }
    });

    // Initialise the add-guest form ranges container with one empty row
    addRange('gf-ranges');
    // Set default cleaning fee based on initial total guests (1 adult)
    (document.getElementById('gf-cleaning-fee') as HTMLInputElement).value = '147.00';

    const guestForm  = document.getElementById('guestForm') as HTMLFormElement;
    const guestError = document.getElementById('guestError') as HTMLElement;
    guestForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      guestError.hidden = true;
      const fd = new FormData(guestForm);
      const body = {
        guest_name:     String(fd.get('guest_name')    ?? '').trim(),
        booking_number: String(fd.get('booking_number') ?? '').trim() || null,
        channel:        String(fd.get('channel')        ?? '').trim() || 'booking.com',
        country:        String(fd.get('country')        ?? '') || null,
        booking_date:   String(fd.get('booking_date')   ?? '') || null,
        total_guests:   Number(fd.get('total_guests')   ?? 1),
        adults:         Number(fd.get('adults')         ?? 1),
        children:       Number(fd.get('children')       ?? 0),
        children_ages:  String(fd.get('children_ages')  ?? '').trim() || null,
        email:          String(fd.get('email')          ?? '').trim() || null,
        phone:          String(fd.get('phone')          ?? '').trim() || null,
        notes:          String(fd.get('notes')          ?? '').trim() || null,
        checkin_hour:   String(fd.get('checkin_hour')   ?? '').trim() || null,
        checkout_hour:  String(fd.get('checkout_hour')  ?? '').trim() || null,
        commission:     fd.get('commission') !== null && String(fd.get('commission')) !== '' ? Number(fd.get('commission')) : null,
        vat:            (document.getElementById('gf-vat') as HTMLInputElement)?.checked ?? false,
        cleaning_fee:   fd.get('cleaning_fee') !== null && String(fd.get('cleaning_fee')) !== '' ? Number(fd.get('cleaning_fee')) : null,
        ranges:         collectRanges('gf-ranges'),
      };
      try {
        await api('/api/admin/cleaning-guests', { method: 'POST', body: JSON.stringify(body) });
        guestForm.reset();
        // Re-init form state after reset
        document.getElementById('gf-ranges')!.innerHTML = '';
        addRange('gf-ranges');
        (document.getElementById('gf-channel') as HTMLInputElement).value = 'booking.com';
        (document.getElementById('gf-cleaning-fee') as HTMLInputElement).value = '147.00';
        calcRangesFor('gf-ranges');
        await refresh();
      } catch (e) {
        guestError.textContent = e instanceof Error ? e.message : 'Failed to add guest';
        guestError.hidden = false;
      }
    });

    refresh()
      .then(() => { loading.style.display = 'none'; content.hidden = false; })
      .catch(() => { /* api() already redirected */ });
  </script>
</body>
</html>
