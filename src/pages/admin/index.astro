---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
  <title>Admin | Blue Moon Apartment</title>
</head>
<body class="adm-body">
  <header class="adm-header">
    <div class="adm-header__inner">
      <a href="/" class="adm-header__brand">
        <img src="/images/nav-logo.svg" alt="Blue Moon Apartment" width="100" height="50" />
      </a>
      <span class="adm-header__title">Admin</span>
      <button class="btn btn-secondary adm-header__logout" id="logoutBtn" type="button">Sign out</button>
    </div>
  </header>

  <nav class="adm-tabnav">
    <div class="adm-tabnav__inner">
      <button class="adm-tabnav__tab adm-tabnav__tab--active" data-tab="booking" type="button">
        Booking
        <span class="adm-tabnav__badge" id="tabPendingBadge" hidden>0</span>
      </button>
      <button class="adm-tabnav__tab" data-tab="settings" type="button">Settings</button>
      <button class="adm-tabnav__tab" data-tab="guest-data" type="button">Guest Data</button>
    </div>
  </nav>

  <main class="adm-main">
    <div id="loading" class="adm-loading">Loading…</div>
    <div id="content" hidden>

      <div id="panel-booking" class="adm-panel">

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Add reservation</h2>
            <button class="adm-btn adm-btn--approve" id="newResToggle" type="button" onclick="__toggleNewReservation()">+ New reservation</button>
          </div>
          <div id="newResPanel" hidden>
            <p class="adm-section__hint">Entered by hand, so none of the booking rules apply — past dates, any number of nights and stays that overlap other reservations are all accepted. The reservation is saved as <strong>confirmed</strong> straight away and <strong>no email is sent</strong>; use the send buttons on the reservation itself afterwards.</p>
            <div class="adm-guest-form" id="newResFields"></div>
            <div class="adm-form-row" style="margin-top:0.75rem;gap:0.5rem;">
              <button class="btn btn-primary" type="button" onclick="__createReservation()">Add reservation</button>
              <button class="adm-btn" type="button" style="background:var(--white);border:1px solid #d4d9de;" onclick="__toggleNewReservation()">Cancel</button>
            </div>
            <p class="adm-form-error" id="nr-error" hidden></p>
          </div>
        </section>

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Pending requests</h2>
            <span class="adm-count" id="pendingCount">0</span>
          </div>
          <div id="pendingList"></div>
        </section>

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Confirmed reservations</h2>
            <span class="adm-count" id="confirmedCount">0</span>
          </div>
          <div id="confirmedList"></div>
        </section>

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Other reservations</h2>
            <span class="adm-count" id="otherCount">0</span>
          </div>
          <p class="adm-section__hint">Declined and cancelled reservations are kept for audit but no longer hold any dates.</p>
          <div id="otherList"></div>
        </section>

      </div><!-- /panel-booking -->

      <div id="panel-settings" class="adm-panel" hidden>

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Manual blocks</h2>
          </div>
          <p class="adm-section__hint">Use this for off-platform bookings (Booking.com, owner stays, maintenance). Both dates are inclusive.</p>

          <form id="blockForm" class="adm-block-form">
            <div class="adm-form-row">
              <div class="form-group">
                <label for="blockFrom">From</label>
                <input type="date" id="blockFrom" name="from" required min="2026-06-01" max="2026-09-30" />
              </div>
              <div class="form-group">
                <label for="blockTo">To</label>
                <input type="date" id="blockTo" name="to" required min="2026-06-01" max="2026-09-30" />
              </div>
              <div class="form-group" style="flex:1;">
                <label for="blockNote">Note (optional)</label>
                <input type="text" id="blockNote" name="note" placeholder="e.g. Booking.com reservation" />
              </div>
              <button type="submit" class="btn btn-primary">Add block</button>
            </div>
            <p class="adm-form-error" id="blockError" hidden></p>
          </form>

          <div id="blocksList"></div>
        </section>

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Pricing (per night, EUR)</h2>
          </div>
          <p class="adm-section__hint">Changes apply to new reservation requests immediately. Already-confirmed reservations keep their original price.</p>
          <div id="pricingList"></div>
        </section>

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Booking settings</h2>
          </div>
          <p class="adm-section__hint">These settings apply immediately to all new booking requests.</p>
          <div id="settingsList"></div>
        </section>

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Cleaning crew docs</h2>
          </div>
          <p class="adm-section__hint">Write guides and checklists for the cleaning crew using markdown. Documents appear in a dropdown on the crew page.</p>

          <div class="adm-form-row">
            <div class="form-group" style="flex:1;">
              <label for="doc-title">Title</label>
              <input type="text" id="doc-title" placeholder="e.g. Checkout Checklist" />
            </div>
            <button class="btn btn-primary" id="doc-save-btn" onclick="__saveDoc()">Add doc</button>
            <button class="adm-btn" id="doc-cancel-btn" style="background:var(--white);border:1px solid #d4d9de;" hidden onclick="__cancelDocEdit()">Cancel</button>
          </div>
          <div class="adm-form-row" style="margin-top:0.75rem;margin-bottom:1rem;">
            <div class="form-group" style="flex:1;">
              <label for="doc-content">Content (Markdown)</label>
              <textarea id="doc-content" rows="12" style="resize:vertical;width:100%;font-family:monospace;font-size:0.88rem;" placeholder="# Checkout Checklist&#10;&#10;- Check all rooms&#10;- Remove trash&#10;- Clean bathrooms"></textarea>
            </div>
          </div>
          <p class="adm-form-error" id="docError" hidden></p>
          <div id="docsList"></div>
        </section>

      </div><!-- /panel-settings -->

      <div id="panel-guest-data" class="adm-panel" hidden>

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Add guest</h2>
          </div>
          <p class="adm-section__hint">Enter guest details and pricing ranges. Nights, discount %, and totals are calculated automatically.</p>

          <form id="guestForm" class="adm-guest-form">
            <div class="adm-form-row">
              <div class="form-group" style="flex:2;">
                <label for="gf-name">Guest name *</label>
                <input type="text" id="gf-name" name="guest_name" required placeholder="Full name" />
              </div>
              <div class="form-group" style="flex:1;">
                <label for="gf-booking">Booking number</label>
                <input type="text" id="gf-booking" name="booking_number" placeholder="e.g. 1234567890" />
              </div>
              <div class="form-group">
                <label for="gf-channel">Channel *</label>
                <input type="text" id="gf-channel" name="channel" list="gf-channel-list" value="booking.com"
                       oninput="__onChannelChange('gf','')" />
                <datalist id="gf-channel-list">
                  <option value="booking.com"></option>
                  <option value="web"></option>
                </datalist>
              </div>
              <div class="form-group">
                <label for="gf-bdate">Booking date</label>
                <input type="date" id="gf-bdate" name="booking_date" />
              </div>
            </div>
            <div class="adm-form-row">
              <div class="form-group">
                <label for="gf-country">Country</label>
                <select id="gf-country" name="country">
                  <option value="">— select —</option>
                  <option>Croatia</option>
                  <option>Czechia</option>
                  <option>Germany</option>
                  <option>Italy</option>
                  <option>Poland</option>
                  <option>Slovakia</option>
                  <option>Slovenia</option>
                  <option>Switzerland</option>
                  <option>United Kingdom</option>
                  <option>Other</option>
                </select>
              </div>
              <div class="form-group">
                <label for="gf-adults">Adults *</label>
                <input type="number" id="gf-adults" name="adults" min="0" value="1" required
                       oninput="__calcGuestTotal('gf','')" />
              </div>
              <div class="form-group">
                <label for="gf-children">Children</label>
                <input type="number" id="gf-children" name="children" min="0" value="0"
                       oninput="__calcGuestTotal('gf','')" />
              </div>
              <div class="form-group">
                <label>Total guests</label>
                <input type="number" id="gf-total" name="total_guests" min="1" value="1" tabindex="-1" readonly
                       style="background:transparent;color:var(--text-muted);cursor:default;" />
              </div>
            </div>
            <div class="adm-form-row">
              <div class="form-group">
                <label for="gf-checkin-hour">Check-in hour</label>
                <input type="text" id="gf-checkin-hour" name="checkin_hour" placeholder="e.g. 15:00" />
              </div>
              <div class="form-group">
                <label for="gf-checkout-hour">Check-out hour</label>
                <input type="text" id="gf-checkout-hour" name="checkout_hour" placeholder="e.g. 10:00" />
              </div>
              <div class="form-group" style="flex:1;">
                <label for="gf-cages">Children's ages</label>
                <input type="text" id="gf-cages" name="children_ages" placeholder="e.g. 3, 7" />
              </div>
            </div>
            <div class="adm-form-row">
              <div class="form-group" style="flex:1;">
                <label for="gf-email">Email</label>
                <input type="email" id="gf-email" name="email" />
              </div>
              <div class="form-group" style="flex:1;">
                <label for="gf-phone">Phone</label>
                <input type="tel" id="gf-phone" name="phone" />
              </div>
            </div>
            <div class="adm-form-row">
              <div class="form-group" style="flex:1;">
                <label for="gf-notes">Notes</label>
                <textarea id="gf-notes" name="notes" placeholder="Any special notes for the cleaning crew" rows="2"></textarea>
              </div>
            </div>

            <!-- Pricing ranges -->
            <div class="guest-ranges">
              <div class="guest-ranges__header">
                <span class="guest-ranges__title">Pricing ranges</span>
                <button type="button" class="adm-btn adm-btn--sm" onclick="__addRange('gf-ranges')">+ Add range</button>
              </div>
              <div class="guest-ranges__labels">
                <span>Start date</span><span>End date</span><span>Nights</span>
                <span>Full €/night</span><span>Disc. €/night</span><span>Disc. %</span><span>Range total</span><span></span>
              </div>
              <div id="gf-ranges" class="guest-ranges__rows" data-prefix="gf" data-suffix=""></div>
              <div class="guest-ranges__footer">
                <span>Total nights: <strong id="gf-total-nights">—</strong></span>
                <span>Final price: <strong id="gf-final-price">—</strong></span>
              </div>
            </div>

            <!-- Financial summary -->
            <div class="guest-financials">
              <div class="adm-form-row">
                <div class="form-group">
                  <label for="gf-commission">Commission (€)</label>
                  <input type="number" id="gf-commission" name="commission" min="0" step="0.01" placeholder="0.00"
                         oninput="__calcRangesFor('gf-ranges')" />
                </div>
                <div class="form-group">
                  <label>Commission %</label>
                  <span id="gf-commission-pct" class="adm-derived-value">—</span>
                </div>
                <div class="form-group">
                  <label>Payout</label>
                  <span id="gf-payout" class="adm-derived-value">—</span>
                </div>
              </div>
              <div class="adm-form-row" style="align-items:center;">
                <div class="form-group">
                  <label class="adm-checkbox-label">
                    <input type="checkbox" id="gf-vat" name="vat" onchange="__calcRangesFor('gf-ranges')" />
                    VAT (25% of commission)
                  </label>
                </div>
                <div class="form-group">
                  <label>VAT amount</label>
                  <span id="gf-vat-amount" class="adm-derived-value">—</span>
                </div>
              </div>
              <div class="adm-form-row">
                <div class="form-group">
                  <label for="gf-cleaning-fee">Cleaning fee (€)</label>
                  <input type="number" id="gf-cleaning-fee" name="cleaning_fee" min="0" step="0.01"
                         oninput="__calcRangesFor('gf-ranges')" />
                </div>
                <div class="form-group">
                  <label>Net gain</label>
                  <span id="gf-net-gain" class="adm-derived-value adm-derived-value--highlight">—</span>
                </div>
              </div>
            </div>

            <div class="adm-form-row" style="margin-top:0.5rem;">
              <button type="submit" class="btn btn-primary">Add guest</button>
            </div>
            <p class="adm-form-error" id="guestError" hidden></p>
          </form>
        </section>

        <section class="adm-section">
          <div class="adm-section__head">
            <h2>Guest list</h2>
            <span class="adm-count" id="guestCount">0</span>
          </div>
          <div id="guestsList"></div>
        </section>

      </div><!-- /panel-guest-data -->

    </div>
  </main>

  <style is:global>
    .adm-body {
      background: var(--soft-sky);
      min-height: 100vh;
      margin: 0;
    }

    .adm-header {
      background: var(--white);
      border-bottom: 1px solid rgba(74,159,212,0.15);
      box-shadow: var(--shadow-xs);
    }
    .adm-header__inner {
      max-width: none;
      margin: 0 auto;
      padding: 0.85rem 2rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    .adm-header__brand img { display: block; height: 44px; width: auto; }
    .adm-header__title {
      flex: 1;
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      color: var(--ocean-blue);
      font-size: 1.1rem;
    }
    .adm-header__logout { padding: 0.5rem 1rem; font-size: 0.82rem; }

    .adm-tabnav {
      background: var(--white);
      border-bottom: 2px solid rgba(74,159,212,0.15);
    }
    .adm-tabnav__inner {
      max-width: none;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
    }
    .adm-tabnav__tab {
      font-family: 'Nunito', sans-serif;
      font-size: 0.88rem;
      font-weight: 800;
      color: var(--text-muted);
      background: none;
      border: none;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      padding: 0.85rem 1.25rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.45rem;
      transition: color 0.15s, border-color 0.15s;
    }
    .adm-tabnav__tab:hover { color: var(--ocean-blue); }
    .adm-tabnav__tab--active {
      color: var(--ocean-blue);
      border-bottom-color: var(--ocean-blue);
    }
    .adm-tabnav__badge {
      background: var(--ocean-blue);
      color: var(--white);
      font-size: 0.68rem;
      font-weight: 800;
      padding: 0.1rem 0.45rem;
      border-radius: 999px;
      min-width: 18px;
      text-align: center;
      line-height: 1.5;
    }

    .adm-main { max-width: none; margin: 0 auto; padding: 2rem; }

    .adm-loading {
      text-align: center;
      padding: 4rem;
      color: var(--text-muted);
      font-weight: 700;
    }

    .adm-section {
      background: var(--white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-xs);
      padding: 1.5rem 1.75rem;
      margin-bottom: 1.5rem;
    }
    .adm-section__head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .adm-section__head h2 { font-size: 1.25rem; margin: 0; }
    .adm-section__hint { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem; }

    .adm-count {
      background: var(--soft-sky);
      color: var(--ocean-blue);
      font-size: 0.78rem;
      font-weight: 800;
      padding: 0.15rem 0.6rem;
      border-radius: 999px;
    }

    .adm-empty {
      color: var(--text-muted);
      font-size: 0.88rem;
      font-style: italic;
      text-align: center;
      padding: 1rem;
    }

    .adm-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.86rem;
    }
    .adm-table th {
      text-align: left;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
      font-weight: 800;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid rgba(74,159,212,0.15);
    }
    .adm-table td {
      padding: 0.75rem;
      border-bottom: 1px solid rgba(74,159,212,0.08);
      vertical-align: top;
    }
    .adm-table tr:last-child td { border-bottom: none; }
    .adm-table strong { color: var(--text-dark); font-weight: 700; }

    .adm-status {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
    }
    .adm-status--pending   { background: #f7e8c4; color: #8a6d2a; }
    .adm-status--confirmed { background: #c6e8f7; color: var(--ocean-blue); }
    .adm-status--declined  { background: #f1dada; color: #a64141; }
    .adm-status--cancelled { background: #d4d9de; color: #6a7989; }

    .adm-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: flex-start; }
    .adm-btn {
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      font-size: 0.78rem;
      padding: 0.4rem 0.8rem;
      border-radius: 8px;
      border: 1px solid transparent;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      line-height: 1.25;
      text-align: center;
    }
    .adm-btn--approve { background: var(--ocean-blue); color: var(--white); }
    .adm-btn--approve:hover { background: #1452a0; }
    .adm-btn--decline { background: var(--white); color: #a64141; border-color: #f1dada; }
    .adm-btn--decline:hover { background: #f1dada; }
    .adm-btn--cancel  { background: var(--white); color: #a64141; border-color: #f1dada; }
    .adm-btn--cancel:hover  { background: #f1dada; }
    /* Guest-email send buttons: green until sent, grey once sent (then they read "Resend …"). */
    .adm-btn--send { background: #e8f5e9; color: #2e7d32; border-color: #a5d6a7; }
    .adm-btn--send:hover { background: #c8e6c9; }
    .adm-btn--resend { background: var(--white); color: #6a7989; border-color: #d4d9de; }
    .adm-btn--resend:hover { background: #d4d9de; }
    /* Amber state: the mail is due (check-in within 3 days) and has not gone out yet. */
    .adm-btn--due { background: #fff4dd; color: #8a6300; border-color: #E8A82A; }
    .adm-btn--due:hover { background: #ffe6bb; }
    /* Every button in the actions row is two text lines tall with its label centred, so a
       one-line label (Edit, Delete reservation) sits level with the two-line send buttons. */
    .adm-actions .adm-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
    }
    .adm-sent-note { font-size: 0.68rem; color: var(--text-muted); line-height: 1.35; }
    .adm-sent-note--due { color: #8a6300; font-weight: 800; }
    /* Fixed width, so "Send" and "Resend" cannot shift a column: the send buttons stay in
       line down the table however many mails have gone out for a given reservation. */
    .adm-send-group { display: flex; flex-direction: column; align-items: stretch; gap: 0.15rem; text-align: center; flex: 0 0 10.25rem; }
    .adm-btn--remove  { background: var(--white); color: #a64141; border-color: #f1dada; }
    .adm-btn--remove:hover  { background: #f1dada; }
    .adm-btn--sm { padding: 0.25rem 0.6rem; font-size: 0.74rem; }

    .adm-block-form { margin-bottom: 1rem; }
    .adm-guest-form { margin-bottom: 1rem; }
    .adm-guest-form .adm-form-row + .adm-form-row { margin-top: 0.75rem; }
    .adm-guest-edit-row td { background: var(--white); padding: 0.75rem 0.75rem 1rem; border-top: 2px solid var(--sky-blue); }
    .adm-guest-edit-form .adm-form-row + .adm-form-row { margin-top: 0.6rem; }
    /* Guest rows propagated from a reservation: the booking tab owns their stay fields. */
    .adm-linked-badge {
      display: inline-block; padding: 0 0.3rem; border-radius: 3px;
      background: var(--soft-sky); color: var(--ocean-blue); font-weight: 700;
    }
    .adm-linked-note {
      margin: 0 0 0.9rem; padding: 0.5rem 0.7rem; border-radius: 5px;
      background: var(--soft-sky); color: var(--ocean-blue);
      font-size: 0.78rem; line-height: 1.45;
    }
    .adm-linked-note a { color: var(--ocean-blue); font-weight: 700; }

    /* A field the booking tab owns: readable, plainly not editable, and white rather
       than transparent so it does not pick up the blue of the panels it sits in. */
    .adm-form-row input.adm-locked,
    .adm-form-row select.adm-locked,
    .adm-form-row textarea.adm-locked,
    .range-row input.adm-locked {
      background: var(--white);
      color: var(--text-muted);
      cursor: default;
    }

    .adm-btn--edit { background: var(--soft-sky); color: var(--ocean-blue); border-color: rgba(74,159,212,0.3); }
    .adm-btn--edit:hover { background: #c6e8f7; }
    .adm-form-row {
      display: flex;
      align-items: end;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .adm-form-row .form-group { display: flex; flex-direction: column; gap: 0.3rem; }
    .adm-form-row label {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .adm-form-row input,
    .adm-form-row textarea,
    .adm-form-row select {
      font-family: 'Nunito', sans-serif;
      font-size: 0.9rem;
      background: var(--soft-sky);
      border: 2px solid transparent;
      border-radius: var(--radius);
      padding: 0.55rem 0.85rem;
      outline: none;
      color: var(--text-dark);
    }
    .adm-form-row input:focus,
    .adm-form-row select:focus { border-color: var(--sky-blue); background: var(--white); }
    .adm-form-row .btn { padding: 0.6rem 1.5rem; font-size: 0.85rem; }
    .adm-form-error { color: #a64141; font-size: 0.82rem; font-weight: 700; margin-top: 0.5rem; }

    .adm-pricing-row {
      display: grid;
      grid-template-columns: 120px 1fr auto auto;
      gap: 1rem;
      align-items: center;
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(74,159,212,0.1);
    }
    .adm-pricing-row:last-child { border-bottom: none; }
    .adm-pricing-row__month { font-weight: 800; color: var(--ocean-blue); }
    .adm-pricing-row__updated { color: var(--text-muted); font-size: 0.78rem; }
    .adm-pricing-row__inputs { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
    .adm-pricing-row__field { display: flex; align-items: center; gap: 0.3rem; }
    .adm-pricing-row__field-label {
      color: var(--text-muted);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .adm-pricing-row__input {
      font-family: 'Nunito', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      background: var(--soft-sky);
      border: 2px solid transparent;
      border-radius: var(--radius);
      padding: 0.5rem 0.85rem;
      outline: none;
      width: 100px;
      text-align: right;
    }
    .adm-pricing-row__input:focus { border-color: var(--sky-blue); background: var(--white); }
    .adm-pricing-row__disc-badge {
      background: var(--sunset-gold);
      color: var(--white);
      border-radius: 4px;
      padding: 0.15rem 0.45rem;
      font-size: 0.72rem;
      font-weight: 800;
    }
    .adm-pricing-row__btn {
      background: var(--ocean-blue);
      color: var(--white);
      border: none;
      border-radius: 8px;
      padding: 0.5rem 1rem;
      font-weight: 800;
      cursor: pointer;
    }
    .adm-pricing-row__btn:hover { background: #1452a0; }
    .adm-pricing-row__btn--saved { background: #4caf50; }

    .adm-settings-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      padding: 0.75rem 0;
    }
    .adm-settings-row__label {
      font-weight: 800;
      color: var(--ocean-blue);
      margin-bottom: 0.2rem;
    }
    .adm-settings-row__hint { color: var(--text-muted); font-size: 0.78rem; }
    .adm-settings-row__input {
      font-family: 'Nunito', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      background: var(--soft-sky);
      border: 2px solid transparent;
      border-radius: var(--radius);
      padding: 0.5rem 0.85rem;
      outline: none;
      width: 80px;
      text-align: right;
    }
    .adm-settings-row__input:focus { border-color: var(--sky-blue); background: var(--white); }

    /* Ranges repeater */
    .guest-ranges {
      border: 1px solid rgba(74,159,212,0.2);
      border-radius: var(--radius);
      background: var(--soft-sky);
      padding: 0.85rem 1rem;
      margin: 0.75rem 0;
    }
    .guest-ranges__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.6rem;
    }
    .guest-ranges__title {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .guest-ranges__labels {
      display: grid;
      grid-template-columns: 130px 130px 52px 100px 100px 62px 90px 28px;
      gap: 0.4rem;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
      padding: 0 0 0.3rem;
      border-bottom: 1px solid rgba(74,159,212,0.15);
      margin-bottom: 0.3rem;
    }
    .range-row {
      display: grid;
      grid-template-columns: 130px 130px 52px 100px 100px 62px 90px 28px;
      gap: 0.4rem;
      align-items: center;
      padding: 0.3rem 0;
      border-bottom: 1px solid rgba(74,159,212,0.08);
    }
    .range-row:last-child { border-bottom: none; }
    .range-row input[type="date"],
    .range-row input[type="number"] {
      font-family: 'Nunito', sans-serif;
      font-size: 0.82rem;
      background: var(--white);
      border: 1px solid rgba(74,159,212,0.25);
      border-radius: 6px;
      padding: 0.35rem 0.5rem;
      outline: none;
      width: 100%;
      box-sizing: border-box;
      color: var(--text-dark);
    }
    .range-row input:focus { border-color: var(--sky-blue); }

    /* A locked range belongs to the reservation. The panel drops its tint and the rows
       read as plain figures, so nothing in here looks like something you can type into.
       Declared after the rules above because it has the same specificity as them. */
    .guest-ranges--locked { background: var(--white); }
    .range-row input.adm-locked {
      background: var(--white);
      border-color: transparent;
      color: var(--text-muted);
      cursor: default;
    }
    .range-disc--error { border-color: #d32f2f !important; background: #fff5f5; }
    .range-nights, .range-disc-pct, .range-total {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 600;
      text-align: right;
    }
    .range-nights { text-align: center; }
    .range-total { color: var(--ocean-blue); font-weight: 700; }
    .guest-ranges__footer {
      display: flex;
      gap: 2rem;
      padding-top: 0.5rem;
      margin-top: 0.4rem;
      border-top: 1px solid rgba(74,159,212,0.15);
      font-size: 0.82rem;
      color: var(--text-muted);
    }
    .guest-ranges__footer strong { color: var(--ocean-blue); }

    /* Derived values display */
    .adm-derived-value {
      display: inline-block;
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--ocean-blue);
      min-height: 2rem;
      line-height: 2rem;
    }
    .adm-derived-value--highlight { color: #2e7d32; }

    /* Financial section */
    .guest-financials {
      border: 1px solid rgba(74,159,212,0.2);
      border-radius: var(--radius);
      background: rgba(74,159,212,0.03);
      padding: 0.85rem 1rem;
      margin: 0.35rem 0 0.75rem;
    }
    .guest-financials .adm-form-row + .adm-form-row { margin-top: 0.6rem; }
    .adm-checkbox-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-dark);
      cursor: pointer;
      line-height: 1.4;
    }
    .adm-checkbox-label input[type="checkbox"] { width: 1rem; height: 1rem; cursor: pointer; }

    @media (max-width: 720px) {
      .adm-main { padding: 1rem; }
      .adm-tabnav__inner { padding: 0 1rem; }
      .adm-section { padding: 1rem; }
      .adm-form-row { flex-direction: column; align-items: stretch; }
      .adm-pricing-row { grid-template-columns: 1fr auto; }
      .adm-pricing-row__updated { display: none; }
      .adm-pricing-row__inputs { gap: 0.5rem; }
      .adm-table { font-size: 0.78rem; }
      .adm-table th, .adm-table td { padding: 0.4rem 0.45rem; }
      .guest-ranges { overflow-x: auto; }
      .guest-ranges__labels, .range-row { min-width: 700px; }
    }
  </style>

  <script>
    type BookingSettings = { minAdvanceDays: number; keyLockerCode: string };
    type Reservation = {
      id: string;
      created_at: number;
      status: 'pending' | 'confirmed' | 'declined' | 'cancelled';
      full_name: string; email: string; phone: string | null; language: string | null;
      address: string | null; source: string | null;
      guests: number; adults: number; children: number; children_ages: string | null;
      check_in: string; check_out: string; nights: number; total_eur: number;
      full_total_eur: number | null; discount_pct: number | null;
      message: string | null; decided_at: number | null; pricing_snapshot: string | null;
      deposit_confirmation_sent_at: number | null; welcome_email_sent_at: number | null;
      evisitor_email_sent_at: number | null;
      received_email_sent_at: number | null; approved_email_sent_at: number | null;
      no_deposit_approved_email_sent_at: number | null;
      payment_confirmation_sent_at: number | null;
      country: string | null;
    };
    type ManualBlock = { id: string; created_at: number; from_date: string; to_date: string; note: string | null };
    type PricingRule = { month: number; rate_eur: number; discount_rate_eur: number | null; updated_at: number };
    type GuestStayRange = {
      id: string; guest_id: string; sort_order: number;
      start_date: string; end_date: string;
      full_price: number; discounted_price: number; nights: number; range_total: number;
    };
    /** A reservation's pricing range, as stored in its snapshot. */
    type ResRange = {
      start_date: string; end_date: string; nights: number;
      full_price: number; discounted_price: number; range_total: number;
    };
    type CleaningGuest = {
      id: string; reservation_id: string | null;
      guest_name: string; booking_number: string | null; country: string | null;
      check_in: string; check_out: string; booking_date: string | null;
      total_guests: number; adults: number; children: number; children_ages: string | null;
      nights: number; email: string | null; phone: string | null; notes: string | null;
      checkin_hour: string | null; checkout_hour: string | null;
      channel: string; commission: number | null; commission_pct: number | null;
      vat: number; vat_amount: number | null; cleaning_fee: number | null;
      final_price: number | null; payout: number | null; net_gain: number | null;
      ranges: GuestStayRange[];
      invoice: { invoice_number: string; sent_at: number } | null;
    };

    type DocItem = { id: string; title: string; slug: string; updated_at: number };

    const loading = document.getElementById('loading')!;
    const content = document.getElementById('content')!;
    const logoutBtn = document.getElementById('logoutBtn') as HTMLButtonElement;

    let editingReservationId: string | null = null;
    let currentReservations: Reservation[] = [];
    let editingGuestId: string | null = null;
    let currentGuests: CleaningGuest[] = [];
    let editingDocId: string | null = null;
    let currentDocs: DocItem[] = [];

    const COUNTRIES = ['Croatia','Czechia','Germany','Italy','Poland','Slovakia','Slovenia','Switzerland','United Kingdom','Other'];

    function countryOptions(selected: string | null): string {
      return `<option value="">— select —</option>` +
        COUNTRIES.map(c => `<option${selected === c ? ' selected' : ''}>${esc(c)}</option>`).join('');
    }

    /** Read-only styling for a field the booking tab owns. */
    const LOCKED_ATTRS = ' readonly tabindex="-1" class="adm-locked"';

    function renderRangeRow(r: GuestStayRange | null, containerId: string, locked = false): string {
      const start   = r?.start_date ?? '';
      const end     = r?.end_date ?? '';
      const full    = r?.full_price ?? '';
      const disc    = r?.discounted_price ?? '';
      const nights  = r ? String(r.nights) : '—';
      const discPct = r && r.full_price > 0 ? ((r.full_price - r.discounted_price) / r.full_price * 100).toFixed(1) + '%' : '—';
      const total   = r ? '€' + r.range_total.toFixed(2) : '—';
      // The lock goes into the existing class attribute rather than beside it: a second
      // class attribute on the same tag is silently dropped by the HTML parser.
      const lk = locked ? ' readonly tabindex="-1"' : '';
      const lc = locked ? ' adm-locked' : '';
      const calc = locked ? '' : ` oninput="__recalcRanges('${containerId}')"`;
      return `<div class="range-row">
        <input type="date" class="range-start${lc}" value="${start}"${lk}${calc} />
        <input type="date" class="range-end${lc}" value="${end}"${lk}${calc} />
        <span class="range-nights">${nights}</span>
        <input type="number" class="range-full${lc}" value="${full}" min="0" step="0.01" placeholder="0.00"${lk}${calc} />
        <input type="number" class="range-disc${lc}" value="${disc}" min="0" step="0.01" placeholder="0.00"${lk}${calc} />
        <span class="range-disc-pct">${discPct}</span>
        <span class="range-total">${total}</span>
        ${locked ? '<span></span>' : `<button type="button" class="adm-btn adm-btn--sm adm-btn--remove" onclick="__removeRangeRow(this,'${containerId}')">×</button>`}
      </div>`;
    }

    function renderGuestTable(guests: CleaningGuest[]): string {
      if (guests.length === 0) return '<p class="adm-empty">No guests entered yet.</p>';
      const rows = guests.map(g => {
        const id = g.id;
        // While a row is linked, the reservation owns the stay: name, contacts, dates,
        // party and price, and therefore the pricing ranges, which are what the price is
        // made of. Everything the reservation has no notion of stays editable.
        const linked = g.reservation_id !== null;
        const lk = linked ? LOCKED_ATTRS : '';
        const rcId = `ef-ranges-${id}`;
        const isEditing = editingGuestId === id;
        const fp = g.final_price !== null ? '€' + g.final_price.toFixed(2) : '—';
        const ng = g.net_gain !== null ? '€' + g.net_gain.toFixed(2) : '—';
        const totalNights = g.ranges.length > 0 ? g.ranges.reduce((s, r) => s + r.nights, 0) : g.nights;
        const rangeRowsHtml = g.ranges.length > 0
          ? g.ranges.map(r => renderRangeRow(r, rcId, linked)).join('')
          : renderRangeRow(null, rcId, linked);

        const inv = g.invoice;
        const hasPrice = g.final_price !== null || g.ranges.length > 0;
        const invoiceBtn = inv
          ? `<button class="adm-btn adm-btn--sm adm-btn--resend" onclick="__sendInvoice('${id}')">Resend invoice</button>`
          : `<button class="adm-btn adm-btn--sm adm-btn--send" onclick="__sendInvoice('${id}')">Send invoice</button>`;
        const invoiceLink = inv
          ? `<a href="#" onclick="__viewInvoice('${id}');return false;" style="color:var(--ocean-blue);">View sent PDF</a>`
          : (hasPrice ? `<a href="#" onclick="__previewInvoice('${id}');return false;" style="color:var(--ocean-blue);">Preview PDF</a>` : '');
        const sentNote = inv ? `&#10003; sent ${fmtTs(inv.sent_at)} &middot; ` : '';
        const invoiceMeta = (sentNote || invoiceLink)
          ? `<div style="margin-top:4px;white-space:nowrap;font-size:0.68rem;color:var(--text-muted);">${sentNote}${invoiceLink}</div>`
          : '';

        const editRow = isEditing ? `
          <tr class="adm-guest-edit-row">
            <td colspan="7">
              <div class="adm-guest-edit-form">
                ${linked ? `<p class="adm-linked-note">&#128274; The stay, guest details and price come from the linked reservation &mdash;
                  <a href="#" onclick="__gotoReservation('${g.reservation_id}');return false;">edit them in the Booking tab</a>.
                  Everything below the contact details is yours to fill in here.</p>` : ''}
                <div class="adm-form-row">
                  <div class="form-group" style="flex:2;">
                    <label>Guest name *</label>
                    <input type="text" id="ef-name-${id}" value="${esc(g.guest_name)}"${lk} />
                  </div>
                  <div class="form-group" style="flex:1;">
                    <label>Booking number</label>
                    <input type="text" id="ef-booking-${id}" value="${esc(g.booking_number ?? '')}"${lk}
                           ${linked ? 'placeholder="\u2014 not used for direct bookings"' : ''} />
                  </div>
                  <div class="form-group">
                    <label>Channel *</label>
                    <input type="text" id="ef-channel-${id}" list="ef-channel-list-${id}"
                           value="${esc(g.channel)}"${lk} ${linked ? '' : `oninput="__onChannelChange('ef','-${id}')"`} />
                    <datalist id="ef-channel-list-${id}">
                      <option value="booking.com"></option><option value="web"></option>
                    </datalist>
                  </div>
                  <div class="form-group">
                    <label>Booking date</label>
                    <input type="date" id="ef-bdate-${id}" value="${g.booking_date ?? ''}"${lk} />
                  </div>
                </div>
                <div class="adm-form-row">
                  <div class="form-group">
                    <label>Country</label>
                    <select id="ef-country-${id}" ${linked ? 'disabled class="adm-locked"' : ''}>${countryOptions(g.country)}</select>
                  </div>
                  <div class="form-group">
                    <label>Adults *</label>
                    <input type="number" id="ef-adults-${id}" value="${g.adults}" min="0"${lk}
                           ${linked ? '' : `oninput="__calcGuestTotal('ef','-${id}')"`} />
                  </div>
                  <div class="form-group">
                    <label>Children</label>
                    <input type="number" id="ef-children-${id}" value="${g.children}" min="0"${lk}
                           ${linked ? '' : `oninput="__calcGuestTotal('ef','-${id}')"`} />
                  </div>
                  <div class="form-group">
                    <label>Total guests</label>
                    <input type="number" id="ef-total-${id}" value="${g.total_guests}" min="1" tabindex="-1" readonly
                           style="background:transparent;color:var(--text-muted);cursor:default;" />
                  </div>
                </div>
                <div class="adm-form-row">
                  <div class="form-group">
                    <label>Check-in hour</label>
                    <input type="text" id="ef-checkin-hour-${id}" value="${esc(g.checkin_hour ?? '')}" placeholder="e.g. 15:00" />
                  </div>
                  <div class="form-group">
                    <label>Check-out hour</label>
                    <input type="text" id="ef-checkout-hour-${id}" value="${esc(g.checkout_hour ?? '')}" placeholder="e.g. 10:00" />
                  </div>
                  <div class="form-group" style="flex:1;">
                    <label>Children's ages</label>
                    <input type="text" id="ef-cages-${id}" value="${esc(g.children_ages ?? '')}"${lk} />
                  </div>
                </div>
                <div class="adm-form-row">
                  <div class="form-group" style="flex:1;">
                    <label>Email</label>
                    <input type="email" id="ef-email-${id}" value="${esc(g.email ?? '')}"${lk} />
                  </div>
                  <div class="form-group" style="flex:1;">
                    <label>Phone</label>
                    <input type="tel" id="ef-phone-${id}" value="${esc(g.phone ?? '')}"${lk} />
                  </div>
                </div>
                <div class="adm-form-row">
                  <div class="form-group" style="flex:1;">
                    <label>Notes</label>
                    <textarea id="ef-notes-${id}" rows="2">${esc(g.notes ?? '')}</textarea>
                  </div>
                </div>

                <div class="guest-ranges${linked ? ' guest-ranges--locked' : ''}">
                  <div class="guest-ranges__header">
                    <span class="guest-ranges__title">Pricing ranges</span>
                    ${linked ? '' : `<button type="button" class="adm-btn adm-btn--sm" onclick="__addRange('${rcId}')">+ Add range</button>`}
                  </div>
                  <div class="guest-ranges__labels">
                    <span>Start date</span><span>End date</span><span>Nights</span>
                    <span>Full €/night</span><span>Disc. €/night</span><span>Disc. %</span><span>Range total</span><span></span>
                  </div>
                  <div id="${rcId}" class="guest-ranges__rows" data-prefix="ef" data-suffix="-${id}">${rangeRowsHtml}</div>
                  <div class="guest-ranges__footer">
                    <span>Total nights: <strong id="ef-total-nights-${id}">${totalNights > 0 ? totalNights : '—'}</strong></span>
                    <span>Final price: <strong id="ef-final-price-${id}">${g.final_price !== null ? '€' + g.final_price.toFixed(2) : '—'}</strong></span>
                  </div>
                </div>

                <div class="guest-financials">
                  <div class="adm-form-row">
                    <div class="form-group">
                      <label>Commission (€)</label>
                      <input type="number" id="ef-commission-${id}" value="${g.commission ?? ''}" min="0" step="0.01" placeholder="0.00"
                             oninput="__calcRangesFor('${rcId}')" />
                    </div>
                    <div class="form-group">
                      <label>Commission %</label>
                      <span id="ef-commission-pct-${id}" class="adm-derived-value">${g.commission_pct !== null ? g.commission_pct.toFixed(1) + '%' : '—'}</span>
                    </div>
                    <div class="form-group">
                      <label>Payout</label>
                      <span id="ef-payout-${id}" class="adm-derived-value">${g.payout !== null ? '€' + g.payout.toFixed(2) : '—'}</span>
                    </div>
                  </div>
                  <div class="adm-form-row" style="align-items:center;">
                    <div class="form-group">
                      <label class="adm-checkbox-label">
                        <input type="checkbox" id="ef-vat-${id}" ${g.vat ? 'checked' : ''} onchange="__calcRangesFor('${rcId}')" />
                        VAT (25% of commission)
                      </label>
                    </div>
                    <div class="form-group">
                      <label>VAT amount</label>
                      <span id="ef-vat-amount-${id}" class="adm-derived-value">${g.vat_amount !== null ? '€' + g.vat_amount.toFixed(2) : '—'}</span>
                    </div>
                  </div>
                  <div class="adm-form-row">
                    <div class="form-group">
                      <label>Cleaning fee (€)</label>
                      <input type="number" id="ef-cleaning-fee-${id}" value="${g.cleaning_fee ?? ''}" min="0" step="0.01"
                             oninput="__calcRangesFor('${rcId}')" />
                    </div>
                    <div class="form-group">
                      <label>Net gain</label>
                      <span id="ef-net-gain-${id}" class="adm-derived-value adm-derived-value--highlight">${g.net_gain !== null ? '€' + g.net_gain.toFixed(2) : '—'}</span>
                    </div>
                  </div>
                </div>

                <div class="adm-form-row" style="margin-top:0.5rem;gap:0.5rem;">
                  <button class="btn btn-primary" style="font-size:0.85rem;padding:0.6rem 1.25rem;" onclick="__saveGuest('${id}')">Save changes</button>
                  <button class="adm-btn" style="background:var(--white);border:1px solid #d4d9de;" onclick="__cancelEdit()">Cancel</button>
                  ${linked ? `<button class="adm-btn adm-btn--remove" style="margin-left:auto;" onclick="__unlinkGuest('${id}')">Unlink from booking</button>` : ''}
                </div>
                <p class="adm-form-error" id="ef-error-${id}" hidden></p>
              </div>
            </td>
          </tr>` : '';
        return `
          <tr>
            <td><strong>${esc(g.guest_name)}</strong><br><span style="font-size:0.75rem;color:var(--text-muted);">${esc(g.channel)}${linked ? ' &middot; <span class="adm-linked-badge">from web</span>' : ''}</span></td>
            <td>${fmtDate(g.check_in)}</td>
            <td>${fmtDate(g.check_out)}</td>
            <td>${g.nights}</td>
            <td>${g.total_guests}${g.children > 0 ? ` (${g.children} ch.)` : ''}</td>
            <td>${fp}<br><span style="font-size:0.75rem;color:#2e7d32;">${ng}</span></td>
            <td style="white-space:nowrap;">
              <div style="display:inline-block;text-align:right;">
                <button class="adm-btn adm-btn--sm${isEditing ? '' : ''}" style="${isEditing ? 'background:var(--soft-sky);color:var(--ocean-blue);border-color:rgba(74,159,212,0.3);border:1px solid rgba(74,159,212,0.3);' : ''}" onclick="__editGuest('${id}')">Edit</button>
                <button class="adm-btn adm-btn--sm adm-btn--remove" onclick="__removeGuest('${id}')">Remove</button>
                ${invoiceBtn}
                ${invoiceMeta}
              </div>
            </td>
          </tr>
          ${editRow}`;
      }).join('');
      return `<table class="adm-table"><thead><tr>
        <th>Guest / Channel</th><th>Check-in</th><th>Check-out</th>
        <th>Nights</th><th>Guests</th><th>Final / Net</th><th></th>
      </tr></thead><tbody>${rows}</tbody></table>`;
    }

    // ── Tabs ────────────────────────────────────────────────────────────────
    type TabName = 'booking' | 'settings' | 'guest-data';
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.adm-tabnav__tab');
    const panels  = {
      booking:     document.getElementById('panel-booking')!,
      settings:    document.getElementById('panel-settings')!,
      'guest-data': document.getElementById('panel-guest-data')!,
    };
    const tabPendingBadge = document.getElementById('tabPendingBadge')!;

    function switchTab(name: TabName) {
      tabBtns.forEach(b => b.classList.toggle('adm-tabnav__tab--active', b.dataset.tab === name));
      (Object.keys(panels) as TabName[]).forEach(k => { panels[k].hidden = k !== name; });
      const hash = name === 'settings' ? '#settings' : name === 'guest-data' ? '#guest-data' : location.pathname;
      history.replaceState(null, '', hash);
    }

    tabBtns.forEach(b => b.addEventListener('click', () => switchTab(b.dataset.tab as TabName)));

    const initialTab: TabName =
      location.hash === '#settings' ? 'settings' :
      location.hash === '#guest-data' ? 'guest-data' : 'booking';
    switchTab(initialTab);
    // ────────────────────────────────────────────────────────────────────────

    const monthName = (m: number) => ({6: 'June', 7: 'July', 8: 'August', 9: 'September'} as const)[m as 6|7|8|9];
    const fmtDate = (iso: string) => {
      const [y, mo, d] = iso.split('-').map(Number);
      return new Date(y, mo - 1, d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    };
    const fmtTs = (sec: number) => new Date(sec * 1000).toLocaleString('en-GB');
    const fmtEur = (n: number) => `€${n.toLocaleString('en-GB')}`;
    const depositEur = (total: number) => Math.round(total * 0.3);
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    /** Escapes a value used as a single-quoted JS string literal inside an HTML attribute. */
    const escAttrArg = (s: string) => esc(s.replace(/\\/g, '\\\\').replace(/'/g, "\\'"));

    /** Whole days from today until an ISO date. Negative once the date has passed. */
    const daysUntil = (iso: string) => {
      const [y, m, d] = iso.split('-').map(Number);
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      return Math.round((new Date(y, m - 1, d).getTime() - today.getTime()) / 86400000);
    };

    /**
     * How many days before arrival each pre-arrival mail should go out. The welcome info
     * goes early so guests can read the guide while still planning; the eVisitor mail waits
     * until arrival is close, since it carries the key-locker code.
     */
    const WELCOME_DUE_DAYS  = 7;
    const EVISITOR_DUE_DAYS = 3;

    /** Days left until arrival once the mail is due, else null — see guestEmailButton. */
    const dueIn = (checkIn: string, withinDays: number) => {
      const d = daysUntil(checkIn);
      return d >= 0 && d <= withinDays ? d : null;
    };

    /**
     * Renders a guest-email send button plus its sent-at stamp. Green + "Send …" until the
     * email has gone out, then grey + "Resend …" with the timestamp underneath.
     * Adding another guest email is one more call to this.
     *
     * `dueInDays` marks a not-yet-sent email as due: the button turns amber and gains a
     * hint. Pass it only for emails that have a moment they should go out — the welcome
     * info and the eVisitor mail, via dueIn().
     *
     * `label` carries a <br> at its natural break so the verb and the first word share
     * one line and the rest falls to a second. Seven of these sit side by side, and on
     * one line each they push the row far wider than the table needs to be. The sent-at
     * and due notes wrap in the same place for the same reason.
     */
    const guestEmailButton = (sentAt: number | null, label: string, onclick: string, dueInDays?: number | null) => {
      const due = sentAt === null && dueInDays !== null && dueInDays !== undefined;
      const dueHint = dueInDays === 0 ? 'arriving today'
        : dueInDays === 1 ? 'arriving tomorrow'
        : `arriving in ${dueInDays} days`;
      return `
      <div class="adm-send-group">
        <button class="adm-btn ${sentAt ? 'adm-btn--resend' : due ? 'adm-btn--due' : 'adm-btn--send'}" onclick="${onclick}">${sentAt ? 'Resend' : 'Send'} ${label}</button>
        ${sentAt ? `<span class="adm-sent-note">&#10003; Email sent<br>${fmtTs(sentAt)}</span>` : ''}
        ${due ? `<span class="adm-sent-note adm-sent-note--due">&#9679; Due now<br>${dueHint}</span>` : ''}
      </div>`;
    };

    async function api<T>(path: string, init?: RequestInit): Promise<T> {
      const res = await fetch(path, {
        ...init,
        headers: { 'Content-Type': 'application/json', ...(init?.headers ?? {}) },
        credentials: 'same-origin',
      });
      if (res.status === 401) {
        window.location.href = '/admin/login';
        throw new Error('not authenticated');
      }
      const data = await res.json() as T & { ok?: boolean; error?: string };
      if ((data as any).ok === false) throw new Error((data as any).error ?? 'Request failed');
      return data;
    }

    function tableRows(reservations: Reservation[], actions: (r: Reservation) => string): string {
      if (reservations.length === 0) return '<p class="adm-empty">None.</p>';
      const rows = reservations.map(r => `
        <tr id="res-row-${r.id}">
          <td><strong>${esc(r.full_name)}</strong><br><a href="mailto:${esc(r.email)}">${esc(r.email)}</a>${r.phone ? `<br>${esc(r.phone)}` : ''}</td>
          <td>${fmtDate(r.check_in)} → ${fmtDate(r.check_out)}<br><span style="color:var(--text-muted);font-size:0.78rem;">${r.nights} night${r.nights !== 1 ? 's' : ''}, ${r.guests} guest${r.guests !== 1 ? 's' : ''}${r.children > 0 ? ` (${r.children} ch.)` : ''}</span></td>
          <td>${r.full_total_eur && r.full_total_eur > r.total_eur
            ? `<span style="text-decoration:line-through;color:var(--text-muted);font-size:0.85rem;">${fmtEur(r.full_total_eur)}</span> <strong>${fmtEur(r.total_eur)}</strong> <span class="price-badge" style="font-size:0.7rem;">-${r.discount_pct}%</span>`
            : `<strong>${fmtEur(r.total_eur)}</strong>`
          }<br><span style="color:var(--text-muted);font-size:0.72rem;">Dep: ${fmtEur(depositEur(r.total_eur))} &middot; Arr: ${fmtEur(r.total_eur - depositEur(r.total_eur))}</span></td>
          <td><span class="adm-status adm-status--${r.status}">${r.status}</span><br><span style="color:var(--text-muted);font-size:0.72rem;">${fmtTs(r.created_at)}</span></td>
          <td><div class="adm-actions">
            <button class="adm-btn adm-btn--edit" onclick="__editReservation('${r.id}')">Edit</button>
            ${r.status === 'confirmed' ? (guestLinkedIds.has(r.id)
              ? '<span class="adm-sent-note">&#10003; In guest data</span>'
              : `<button class="adm-btn adm-btn--send" onclick="__addToGuestData('${r.id}')">Add to<br>guest data</button>`) : ''}
            ${actions(r)}
          </div></td>
        </tr>
        ${editingReservationId === r.id ? reservationEditRow(r) : ''}
      `).join('');
      return `<table class="adm-table"><thead><tr><th>Guest</th><th>Stay</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody>${rows}</tbody></table>`;
    }

    /** The expanded edit form, as a full-width row under the reservation it belongs to. */
    function reservationEditRow(r: Reservation): string {
      const prefix = `re-${r.id}`;
      return `
        <tr class="adm-guest-edit-row">
          <td colspan="5">
            <div class="adm-guest-edit-form">
              ${reservationFields(prefix, r)}
              <div class="adm-form-row" style="margin-top:0.5rem;gap:0.5rem;">
                <button class="btn btn-primary" style="font-size:0.85rem;padding:0.6rem 1.25rem;" onclick="__saveReservation('${r.id}')">Save changes</button>
                <button class="adm-btn" style="background:var(--white);border:1px solid #d4d9de;" onclick="__cancelResEdit()">Cancel</button>
                <span class="adm-sent-note">Saved as entered — no rules checked, no email sent.</span>
              </div>
              <p class="adm-form-error" id="${prefix}-error" hidden></p>
            </div>
          </td>
        </tr>`;
    }

    /**
     * Redraws the three reservation tables from `currentReservations`. Split out of
     * refresh() so opening or closing an Edit form re-renders without refetching.
     *
     * Email buttons live on confirmed reservations only — pending ones are still awaiting
     * a decision, and their booking-received pair already went out automatically.
     */
    function renderReservationLists() {
      renderReservationTables();
      // The stay and totals are read off the range rows, which only exist once the edit
      // form has been written into the page.
      if (editingReservationId) calcResRanges(`re-${editingReservationId}-ranges`);
    }

    function renderReservationTables() {
      const pending   = currentReservations.filter(r => r.status === 'pending');
      const confirmed = currentReservations.filter(r => r.status === 'confirmed');
      const other     = currentReservations.filter(r => r.status === 'declined' || r.status === 'cancelled');

      document.getElementById('pendingCount')!.textContent   = String(pending.length);
      document.getElementById('confirmedCount')!.textContent = String(confirmed.length);
      document.getElementById('otherCount')!.textContent     = String(other.length);

      tabPendingBadge.textContent = String(pending.length);
      tabPendingBadge.hidden = pending.length === 0;

      document.getElementById('pendingList')!.innerHTML = tableRows(pending, r => `
        <button class="adm-btn adm-btn--approve" onclick="__decide('${r.id}','approve')">Approve</button>
        <button class="adm-btn adm-btn--decline" onclick="__decide('${r.id}','decline')">Decline</button>
      `);
      document.getElementById('confirmedList')!.innerHTML = tableRows(confirmed, r => `
        ${guestEmailButton(r.received_email_sent_at, 'booking<br>received mail', `__sendBookingReceived('${r.id}','${escAttrArg(r.email)}')`)}
        ${guestEmailButton(r.approved_email_sent_at, 'booking<br>approved mail', `__sendBookingApproved('${r.id}','${escAttrArg(r.email)}')`)}
        ${guestEmailButton(r.no_deposit_approved_email_sent_at, 'no-deposit<br>booking approved mail', `__sendBookingApprovedNoDeposit('${r.id}','${escAttrArg(r.email)}')`)}
        ${guestEmailButton(r.deposit_confirmation_sent_at, 'deposit<br>confirmation', `__sendDepositConfirmation('${r.id}')`)}
        ${guestEmailButton(r.payment_confirmation_sent_at, 'full payment<br>confirmation', `__sendPaymentConfirmation('${r.id}','${escAttrArg(r.email)}')`)}
        ${guestEmailButton(r.welcome_email_sent_at, 'welcome<br>info', `__sendWelcomeInfo('${r.id}','${escAttrArg(r.email)}')`, dueIn(r.check_in, WELCOME_DUE_DAYS))}
        ${guestEmailButton(r.evisitor_email_sent_at, 'eVisitor<br>mail', `__sendEvisitorRequest('${r.id}','${escAttrArg(r.email)}')`, dueIn(r.check_in, EVISITOR_DUE_DAYS))}
        <button class="adm-btn adm-btn--cancel" onclick="__decide('${r.id}','cancel')">Delete reservation</button>
      `);
      document.getElementById('otherList')!.innerHTML = tableRows(other, () => '');
    }

    async function decide(id: string, action: 'approve' | 'decline' | 'cancel') {
      if (action === 'cancel' && !confirm('Delete this reservation? Dates will be released.')) return;
      try {
        await api(`/api/admin/reservations/${id}/decision`, {
          method: 'POST',
          body: JSON.stringify({ action }),
        });
        await refresh();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Action failed');
      }
    }
    (window as any).__decide = decide;

    async function sendDepositConfirmation(id: string) {
      if (!confirm('Send deposit received confirmation to the guest?')) return;
      try {
        await api(`/api/admin/reservations/${id}/deposit-received`, { method: 'POST' });
        await refresh();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Failed to send email');
      }
    }
    (window as any).__sendDepositConfirmation = sendDepositConfirmation;

    async function sendPaymentConfirmation(id: string, email: string) {
      if (!confirm(`Send the payment confirmation to ${email}? It states the stay is paid in full, with no balance outstanding.`)) return;
      try {
        await api(`/api/admin/reservations/${id}/payment-confirmation-email`, { method: 'POST' });
        await refresh();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Failed to send email');
      }
    }
    (window as any).__sendPaymentConfirmation = sendPaymentConfirmation;

    async function sendWelcomeInfo(id: string, email: string) {
      if (!confirm(`Send the welcome info (link to the guest guide) to ${email}?`)) return;
      try {
        await api(`/api/admin/reservations/${id}/welcome-email`, { method: 'POST' });
        await refresh();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Failed to send email');
      }
    }
    (window as any).__sendWelcomeInfo = sendWelcomeInfo;

    async function sendEvisitorRequest(id: string, email: string) {
      if (!confirm(`Send the guest registration request — including the key-locker code — to ${email}?`)) return;
      try {
        await api(`/api/admin/reservations/${id}/evisitor-email`, { method: 'POST' });
        await refresh();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Failed to send email');
      }
    }
    (window as any).__sendEvisitorRequest = sendEvisitorRequest;

    // ── Manual reservation entry & editing ───────────────────────────────────
    //
    // The create form and every row's Edit form share one field renderer, so the two
    // stay in step. `prefix` namespaces the input ids: 'nr' for the create form,
    // `re-<id>` for an edit row.
    //
    // Nothing here validates against the booking rules — that is the point of the
    // feature. Dates in the past, one-night stays and overlapping stays all save fine,
    // and no email is ever sent as a side effect of creating or saving.

    const RES_LANGS: Array<[string, string]> = [
      ['en', 'English'], ['hr', 'Hrvatski'], ['de', 'Deutsch'], ['si', 'Slovenščina'],
      ['it', 'Italiano'], ['pl', 'Polski'], ['cz', 'Čeština'],
    ];

    const RES_STATUSES: Array<Reservation['status']> = ['pending', 'confirmed', 'declined', 'cancelled'];

    const addIsoDays = (iso: string, days: number) => {
      const [y, m, d] = iso.split('-').map(Number);
      const dt = new Date(Date.UTC(y, m - 1, d + days));
      return `${dt.getUTCFullYear()}-${String(dt.getUTCMonth() + 1).padStart(2, '0')}-${String(dt.getUTCDate()).padStart(2, '0')}`;
    };

    /**
     * The stay as dated ranges. A new reservation starts with one empty row; an existing
     * one shows what it was actually priced at, whatever shape its snapshot is in — rows
     * from before ranges existed carry a per-month breakdown, or nothing, and both still
     * render as ranges so every reservation looks the same.
     */
    function reservationRangesOf(r: Reservation | null): ResRange[] {
      if (!r) return [];
      let parsed: unknown = null;
      if (r.pricing_snapshot) { try { parsed = JSON.parse(r.pricing_snapshot); } catch { parsed = null; } }

      if (Array.isArray(parsed) && parsed.length > 0) {
        const first = parsed[0] as Record<string, unknown>;
        if (typeof first.start_date === 'string') return parsed as ResRange[];

        const monthly = parsed as Array<{ nights: number; fullRateEur: number; discountRateEur: number }>;
        if (monthly.reduce((acc, m) => acc + (Number(m.nights) || 0), 0) === r.nights) {
          const out: ResRange[] = [];
          let cursor = r.check_in;
          for (const m of monthly) {
            const nights = Number(m.nights);
            const end = addIsoDays(cursor, nights);
            out.push({
              start_date: cursor, end_date: end, nights,
              full_price: Number(m.fullRateEur), discounted_price: Number(m.discountRateEur),
              range_total: Number(m.discountRateEur) * nights,
            });
            cursor = end;
          }
          return out;
        }
      }

      const nights = r.nights > 0 ? r.nights : 1;
      return [{
        start_date: r.check_in, end_date: r.check_out, nights,
        full_price: Math.round((r.full_total_eur ?? r.total_eur) / nights),
        discounted_price: Math.round(r.total_eur / nights),
        range_total: r.total_eur,
      }];
    }

    function reservationFields(prefix: string, r: Reservation | null): string {
      const resRanges = reservationRangesOf(r);
      const resRangeRowsHtml = resRanges.length > 0
        ? resRanges.map(rg => renderRangeRow(rg as GuestStayRange, `${prefix}-ranges`)).join('')
        : renderRangeRow(null, `${prefix}-ranges`);
      const v = (x: string | number | null | undefined) => x === null || x === undefined ? '' : esc(String(x));
      const langOptions = `<option value="">— none —</option>` + RES_LANGS
        .map(([code, name]) => `<option value="${code}"${r?.language === code ? ' selected' : ''}>${name}</option>`).join('');
      const statusOptions = RES_STATUSES
        .map(st => `<option value="${st}"${r?.status === st ? ' selected' : ''}>${st}</option>`).join('');
      const statusField = r ? `
          <div class="form-group">
            <label>Status</label>
            <select id="${prefix}-status">${statusOptions}</select>
          </div>` : '';

      return `
        <div class="adm-form-row">
          <div class="form-group" style="flex:2;">
            <label>Guest name *</label>
            <input type="text" id="${prefix}-full_name" value="${v(r?.full_name)}" placeholder="Full name" />
          </div>
          <div class="form-group" style="flex:2;">
            <label>Email *</label>
            <input type="email" id="${prefix}-email" value="${v(r?.email)}" />
          </div>
          <div class="form-group" style="flex:1;">
            <label>Phone</label>
            <input type="tel" id="${prefix}-phone" value="${v(r?.phone)}" />
          </div>
          ${statusField}
        </div>
        <div class="adm-form-row">
          <div class="form-group">
            <label>Language</label>
            <select id="${prefix}-language">${langOptions}</select>
          </div>
          <div class="form-group">
            <label>Country</label>
            <select id="${prefix}-country">${countryOptions(r?.country ?? null)}</select>
          </div>
          <div class="form-group" style="flex:2;">
            <label>Address</label>
            <input type="text" id="${prefix}-address" value="${v(r?.address)}" />
          </div>
          <div class="form-group" style="flex:1;">
            <label>Source</label>
            <input type="text" id="${prefix}-source" value="${v(r?.source)}" placeholder="e.g. booking.com" />
          </div>
        </div>
        <div class="adm-form-row">
          <div class="form-group" style="flex:1.4;">
            <label>Stay</label>
            <span class="adm-derived-value" id="${prefix}-stay_out">&mdash;</span>
          </div>
          <div class="form-group">
            <label>Nights</label>
            <span class="adm-derived-value" id="${prefix}-nights_out">&mdash;</span>
          </div>
          <div class="form-group">
            <label>Adults *</label>
            <input type="number" id="${prefix}-adults" min="1" value="${r ? v(r.adults) : '2'}"
                   oninput="__calcResParty('${prefix}')" />
          </div>
          <div class="form-group">
            <label>Children</label>
            <input type="number" id="${prefix}-children" min="0" value="${r ? v(r.children) : '0'}"
                   oninput="__calcResParty('${prefix}')" />
          </div>
          <div class="form-group">
            <label>Total guests</label>
            <input type="number" id="${prefix}-guests" value="${r ? v(r.guests) : '2'}" tabindex="-1" readonly
                   style="background:transparent;color:var(--text-muted);cursor:default;" />
          </div>
          <div class="form-group" style="flex:1;">
            <label>Children's ages</label>
            <input type="text" id="${prefix}-children_ages" value="${v(r?.children_ages)}" placeholder="e.g. 3, 7"
                   ${r && r.children > 0 ? '' : 'disabled'} />
          </div>
        </div>

        <div class="guest-ranges">
          <div class="guest-ranges__header">
            <span class="guest-ranges__title">Pricing ranges</span>
            <span style="display:flex;gap:0.4rem;">
              <button type="button" class="adm-btn adm-btn--edit" onclick="__quoteReservation('${prefix}')">Calculate from pricing rules</button>
              <button type="button" class="adm-btn adm-btn--sm" onclick="__addRange('${prefix}-ranges')">+ Add range</button>
            </span>
          </div>
          <div class="guest-ranges__labels">
            <span>Start date</span><span>End date</span><span>Nights</span>
            <span>Full &euro;/night</span><span>Charged &euro;/night</span><span>Disc. %</span><span>Range total</span><span></span>
          </div>
          <div id="${prefix}-ranges" class="guest-ranges__rows" data-kind="reservation" data-prefix="${prefix}" data-suffix="">${resRangeRowsHtml}</div>
          <div class="guest-ranges__footer">
            <span>Full total: <strong id="${prefix}-full_total_out">&mdash;</strong></span>
            <span>Charged: <strong id="${prefix}-total_out">&mdash;</strong></span>
            <span>Discount: <strong id="${prefix}-discount_out">&mdash;</strong></span>
            <span>Deposit / on arrival: <strong id="${prefix}-split">&mdash;</strong></span>
          </div>
        </div>
        </div>
        <div class="adm-form-row">
          <div class="form-group" style="flex:1;">
            <label>Message</label>
            <textarea id="${prefix}-message" rows="2">${v(r?.message)}</textarea>
          </div>
        </div>`;
    }

    /** Reads a namespaced field out of a reservation form. */
    const resField = (prefix: string, name: string) =>
      document.getElementById(`${prefix}-${name}`) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
    const resValue = (prefix: string, name: string) => resField(prefix, name)?.value ?? '';

    /**
     * Keeps the readonly total in step with adults + children, and locks the ages field
     * while there are no children — the same rule the guest-data form uses. Unlike the
     * public form this never rejects anything; the manual path checks no rules.
     */
    function calcResParty(prefix: string) {
      const adults   = parseInt(resValue(prefix, 'adults'))   || 0;
      const children = parseInt(resValue(prefix, 'children')) || 0;
      const totalEl  = resField(prefix, 'guests') as HTMLInputElement | null;
      if (totalEl) totalEl.value = String(adults + children);
      const agesEl = resField(prefix, 'children_ages') as HTMLInputElement | null;
      if (agesEl) {
        agesEl.disabled = children < 1;
        if (children < 1) agesEl.value = '';
      }
    }
    (window as any).__calcResParty = calcResParty;


    /**
     * Totals a reservation's ranges into the readouts above them: the stay, the nights,
     * both money figures and the deposit split. The ranges are the only place these
     * numbers live, so a nightly rate can never disagree with the amount charged.
     */
    function calcResRanges(containerId: string) {
      const container = document.getElementById(containerId);
      if (!container) return;
      const prefix = (container as HTMLElement).dataset.prefix ?? 'nr';
      const id = (n: string) => document.getElementById(`${prefix}-${n}`);

      let nights = 0, charged = 0, fullTotal = 0, firstStart = '', lastEnd = '';

      container.querySelectorAll('.range-row').forEach(row => {
        const start = (row.querySelector('.range-start') as HTMLInputElement)?.value ?? '';
        const end   = (row.querySelector('.range-end')   as HTMLInputElement)?.value ?? '';
        // Whole euros, matching what the server stores, so the figures shown here are
        // exactly the ones that get saved.
        const full  = Math.round(parseFloat((row.querySelector('.range-full') as HTMLInputElement)?.value ?? '') || 0);
        const discEl = row.querySelector('.range-disc') as HTMLInputElement | null;
        const disc   = Math.round(parseFloat(discEl?.value ?? '') || 0);
        const discErr = full > 0 && disc > full;
        discEl?.classList.toggle('range-disc--error', discErr);
        if (discEl) discEl.title = discErr ? 'The charged rate cannot exceed the full rate' : '';

        let n = 0;
        if (start && end && end > start) {
          n = Math.round((new Date(end).getTime() - new Date(start).getTime()) / 86400000);
        }
        const rowTotal = !discErr && n > 0 ? disc * n : 0;
        (row.querySelector('.range-nights')   as HTMLElement).textContent = n > 0 ? String(n) : '\u2014';
        (row.querySelector('.range-disc-pct') as HTMLElement).textContent =
          discErr ? '\u2014' : (full > 0 ? ((full - disc) / full * 100).toFixed(1) + '%' : '\u2014');
        (row.querySelector('.range-total')    as HTMLElement).textContent =
          rowTotal > 0 ? fmtEur(Math.round(rowTotal)) : '\u2014';

        if (n > 0) {
          if (!firstStart || start < firstStart) firstStart = start;
          if (!lastEnd   || end   > lastEnd)     lastEnd   = end;
          nights    += n;
          charged   += rowTotal;
          fullTotal += full * n;
        }
      });

      charged   = Math.round(charged);
      fullTotal = Math.round(fullTotal);
      const pct = fullTotal > 0 ? Math.max(0, Math.round((1 - charged / fullTotal) * 100)) : 0;
      const set = (n: string, t: string) => { const el = id(n); if (el) el.textContent = t; };

      set('stay_out',   firstStart && lastEnd ? `${fmtDate(firstStart)} \u2192 ${fmtDate(lastEnd)}` : '\u2014');
      set('nights_out', nights > 0 ? String(nights) : '\u2014');
      set('full_total_out', fullTotal > 0 ? fmtEur(fullTotal) : '\u2014');
      set('total_out',      charged   > 0 ? fmtEur(charged)   : '\u2014');
      set('discount_out',   fullTotal > 0 ? `-${pct}%` : '\u2014');
      set('split', charged > 0 ? `${fmtEur(depositEur(charged))} / ${fmtEur(charged - depositEur(charged))}` : '\u2014');
    }
    (window as any).__calcResRanges = calcResRanges;

    /** Re-prices the stay from the pricing rules, one range per month, as the guest was quoted. */
    async function quoteReservation(prefix: string) {
      const container = document.getElementById(`${prefix}-ranges`);
      if (!container) return;
      const rows = container.querySelectorAll('.range-row');
      let from = '', to = '';
      rows.forEach(row => {
        const st = (row.querySelector('.range-start') as HTMLInputElement)?.value ?? '';
        const en = (row.querySelector('.range-end')   as HTMLInputElement)?.value ?? '';
        if (st && (!from || st < from)) from = st;
        if (en && (!to   || en > to))   to   = en;
      });
      if (!from || !to) { alert('Set the start and end dates on a range first.'); return; }

      try {
        const q = await api<{ ranges: ResRange[] }>(
          `/api/admin/reservations/quote?checkin=${from}&checkout=${to}`
        );
        // Replaces the rows outright: the rules split the stay by month, which is what
        // the guest was quoted, and anything typed over them was the thing being fixed.
        container.innerHTML = q.ranges
          .map(rg => renderRangeRow(rg as GuestStayRange, `${prefix}-ranges`)).join('');
        calcResRanges(`${prefix}-ranges`);
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Could not calculate a price for those dates');
      }
    }
    (window as any).__quoteReservation = quoteReservation;

    /** The request body shared by create and edit. Empty optional fields become null. */
    function collectReservation(prefix: string): Record<string, unknown> {
      const t = (name: string) => resValue(prefix, name).trim();
