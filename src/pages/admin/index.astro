      if (discount > rate) { alert('Discount rate cannot exceed the full rate'); return; }
      try {
        await api('/api/admin/pricing', {
          method: 'POST',
          body: JSON.stringify({ month, rate_eur: rate, discount_rate_eur: discount }),
