    // Fetch the PDF via XHR (a direct navigation to /api/* is intercepted by the
    // static-assets 404 handler and never reaches the Worker) and open the blob.
    async function openPdf(path: string) {
      const win = window.open('', '_blank'); // opened within the user gesture to avoid popup blocking
      try {
        const res = await fetch(path, { credentials: 'same-origin' });
        if (res.status === 401) { if (win) win.close(); window.location.href = '/admin/login'; return; }
        const ct = res.headers.get('content-type') ?? '';
        if (!res.ok || !ct.includes('application/pdf')) {
          let msg = 'Failed to load PDF';
          try { const j = await res.json() as { error?: string }; if (j.error) msg = j.error; } catch {}
          if (win) win.close();
          alert(msg);
          return;
        }
        const url = URL.createObjectURL(await res.blob());
        if (win) win.location.href = url; else window.open(url, '_blank');
        setTimeout(() => URL.revokeObjectURL(url), 60000);
      } catch (e) {
        if (win) win.close();
        alert(e instanceof Error ? e.message : 'Failed to load PDF');
      }
    }

