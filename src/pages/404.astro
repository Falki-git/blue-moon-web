---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations, SUPPORTED_LANGS, HREFLANG_MAP } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'en';
const T = getTranslations(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;

// Cloudflare serves this one static page for every unmatched path, whatever the
// language prefix, so there is no server-rendered per-locale variant to fall back
// on. Ship every translation with the page and let the script below pick one from
// the URL. Built from the real locale files so it can never drift from them.
const i18nByLang = Object.fromEntries(
  SUPPORTED_LANGS.filter(l => l !== 'en').map(l => {
    const n = getTranslations(l).notFound;
    return [l, {
      hreflang: HREFLANG_MAP[l],
      metaTitle: n.metaTitle,
      heading: n.heading,
      body: n.body,
      backHome: n.backHome,
      checkAvailability: n.checkAvailability,
      orGoTo: n.orGoTo,
      nav: getTranslations(l).nav,
    }];
  })
);
---

<BaseLayout
  title={T.notFound.metaTitle}
  description={T.notFound.metaDescription}
  lang={lang}
>

  <section class="notfound">
    <div class="notfound__bg" aria-hidden="true"></div>
    <div class="container notfound__content">
      <div class="notfound__moon" aria-hidden="true">
        <img src="/images/logo.svg" alt="" width="200" style="height:auto;" />
      </div>
      <h1 class="notfound__code">404</h1>
      <h2 class="notfound__title">{T.notFound.heading}</h2>
      <p class="notfound__text">
        {T.notFound.body}
      </p>
      <div class="notfound__links">
        <a href={`${prefix}/`} class="btn btn-primary">{T.notFound.backHome}</a>
        <a href={`${prefix}/booking`} class="btn btn-sky">{T.notFound.checkAvailability}</a>
      </div>

      <div class="notfound__quicklinks">
        <p>{T.notFound.orGoTo}</p>
        <ul>
          <li><a href={`${prefix}/apartment`} data-nav-key="apartment">{T.nav.apartment}</a></li>
          <li><a href={`${prefix}/pricelist`} data-nav-key="pricelist">{T.nav.pricelist}</a></li>
          <li><a href={`${prefix}/gallery`} data-nav-key="gallery">{T.nav.gallery}</a></li>
          <li><a href={`${prefix}/about-mandre`} data-nav-key="aboutMandre">{T.nav.aboutMandre}</a></li>
          <li><a href={`${prefix}/contact`} data-nav-key="contact">{T.nav.contact}</a></li>
          <li><a href={`${prefix}/directions`} data-nav-key="directions">{T.nav.directions}</a></li>
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>

<script type="application/json" id="nfI18n" set:html={JSON.stringify(i18nByLang)} is:inline></script>

<script>
  (function () {
    type Nf = {
      hreflang: string;
      metaTitle: string;
      heading: string;
      body: string;
      backHome: string;
      checkAvailability: string;
      orGoTo: string;
      nav: Record<string, string>;
    };

    const raw = document.getElementById('nfI18n')?.textContent;
    if (!raw) return;
    const i18n = JSON.parse(raw) as Record<string, Nf>;

    // hasOwnProperty, not `in` — a path like /constructor/foo would otherwise
    // match an inherited Object.prototype key and blow up below.
    const seg = location.pathname.split('/').filter(Boolean);
    const lang = Object.prototype.hasOwnProperty.call(i18n, seg[0]) ? seg[0] : '';
    if (!lang) return;

    const prefix = '/' + lang;

    // Fix every internal link so it carries the lang prefix
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach(a => {
      const href = a.getAttribute('href')!;
      if (href !== prefix && !href.startsWith(prefix + '/')) {
        a.setAttribute('href', prefix + href);
      }
    });

    const t = i18n[lang];

    document.documentElement.lang = t.hreflang;
    document.title = t.metaTitle;

    const title  = document.querySelector('.notfound__title');
    const body   = document.querySelector('.notfound__text');
    const btns   = document.querySelectorAll<HTMLAnchorElement>('.notfound__links a');
    const orGoTo = document.querySelector('.notfound__quicklinks p');

    if (title)   title.textContent   = t.heading;
    if (body)    body.textContent    = t.body;
    if (btns[0]) btns[0].textContent = t.backHome;
    if (btns[1]) btns[1].textContent = t.checkAvailability;
    if (orGoTo)  orGoTo.textContent  = t.orGoTo;

    document.querySelectorAll<HTMLAnchorElement>('.notfound__quicklinks a[data-nav-key]').forEach(a => {
      const label = t.nav[a.dataset.navKey!];
      if (label) a.textContent = label;
    });
  })();
</script>

<style>
  .notfound {
    position: relative;
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 4rem 0;
  }

  .notfound__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, var(--soft-sky) 0%, var(--white) 50%, var(--warm-sand) 100%);
    z-index: 0;
  }
  .notfound__bg::before {
    content: '';
    position: absolute;
    top: -100px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(74,159,212,0.08) 0%, transparent 70%);
    border-radius: 50%;
  }
  .notfound__bg::after {
    content: '';
    position: absolute;
    bottom: -80px;
    left: -80px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(232,168,42,0.08) 0%, transparent 70%);
    border-radius: 50%;
  }

  .notfound__content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 620px;
    margin: 0 auto;
  }

  .notfound__moon img {
    opacity: 0.85;
    filter: drop-shadow(0 8px 32px rgba(74,159,212,0.25));
    animation: floatMoon 4s ease-in-out infinite;
  }

  @keyframes floatMoon {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-12px); }
  }

  .notfound__code {
    font-family: 'Playfair Display', serif;
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 3px var(--ocean-blue);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .notfound__title {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    color: var(--ocean-blue);
    margin: 0;
  }

  .notfound__text {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 480px;
  }

  .notfound__links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .notfound__quicklinks {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(74,159,212,0.2);
    width: 100%;
  }
  .notfound__quicklinks p {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
  }
  .notfound__quicklinks ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.5rem;
  }
  .notfound__quicklinks a {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--sky-blue);
    text-decoration: none;
    transition: color 0.2s;
  }
  .notfound__quicklinks a:hover { color: var(--ocean-blue); }
</style>
